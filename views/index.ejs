<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitoring Progress Pendataan</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.9; transform: scale(1.02); }
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen font-sans antialiased">

    <!-- Panel Kontrol Sirine Darurat (Otomatis Muncul Jika Progress < 10) -->
    <div id="sirenControlPanel" style="display:none;" class="fixed top-5 right-5 z-50 bg-red-600 text-white px-5 py-4 rounded-xl font-bold shadow-2xl border-2 border-white animate-pulse flex items-center gap-4">
        <span>⚠️ PERINGATAN: Progress Harian PCL Kurang dari 10!</span>
        <button onclick="stopSiren()" class="bg-white text-red-600 px-4 py-2 rounded-lg font-bold shadow hover:bg-slate-100 transition">Tutup Sirine</button>
    </div>

    <!-- Header / Navbar Utama -->
    <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-40 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div>
                <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-white flex items-center gap-2">
                    📊 Dashboard Monitoring Pendataan
                </h1>
                <p class="text-xs sm:text-sm text-slate-400">Sinkronisasi Real-Time Google Drive</p>
            </div>
            <div class="text-right">
                <span class="inline-block bg-slate-700 text-slate-300 text-xs px-3 py-1.5 rounded-full font-medium border border-slate-600">
                    📅 Update: <strong class="text-white"><%= activeDate %></strong>
                </span>
            </div>
        </div>
    </header>

    <!-- Konten Utama -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

        <!-- Kartu Ringkasan Utama & Kotak Indikator Progress Harian PCL -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <!-- Ringkasan Kecamatan Kretek -->
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 shadow-lg flex flex-col justify-between">
                <div>
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Kecamatan Kretek</span>
                    <h3 class="text-2xl font-bold text-white mt-1">Capaian Total</h3>
                </div>
                <div class="my-4">
                    <div class="text-4xl font-extrabold text-blue-400"><%= persentaseKretek %>%</div>
                    <p class="text-xs text-slate-400 mt-1">Realisasi: <%= totalDidataKretek.toLocaleString('id-ID') %> dari Target <%= totalTargetKretek.toLocaleString('id-ID') %></p>
                </div>
                <div class="w-full bg-slate-700 rounded-full h-2.5 overflow-hidden">
                    <div class="bg-blue-500 h-2.5 rounded-full" style="width: <%= Math.min(parseFloat(persentaseKretek), 100) %>%"></div>
                </div>
            </div>

            <!-- Kotak Dinamis Progress Harian PCL (Evaluasi Warna & Sirine) -->
            <div id="pclHarianBox" class="border rounded-2xl p-6 shadow-lg flex flex-col justify-between transition-colors duration-500" style="background-color: rgba(30, 41, 59, 0.9); border-color: #475569;">
                <div>
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-300">Status Harian PCL</span>
                    <h3 class="text-xl font-bold text-white mt-1">Evaluasi Kinerja PCL</h3>
                </div>
                <div class="my-4">
                    <% 
                        // Ambil nilai harian PCL rata-rata atau maksimum untuk evaluasi awal
                        let avgHarian = detailedPcl.length > 0 ? (detailedPcl.reduce((acc, curr) => acc + curr.harian, 0) / detailedPcl.length) : 0;
                    %>
                    <div class="text-3xl font-extrabold text-white" id="displayAvgHarian"><%= avgHarian.toFixed(1) %></div>
                    <p class="text-xs text-slate-200 mt-1">Rata-rata / Total Progress Harian Terbaru</p>
                </div>
                <div class="text-xs font-medium text-slate-200 bg-black/20 p-2 rounded-lg">
                    ℹ️ Hijau jika harian >= 10, Merah + Sirine jika di bawah 10.
                </div>
            </div>

            <!-- Ringkasan Cepat Petugas -->
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 shadow-lg flex flex-col justify-between">
                <div>
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Petugas Lapangan</span>
                    <h3 class="text-2xl font-bold text-white mt-1">Personil Aktif</h3>
                </div>
                <div class="my-4 grid grid-cols-2 gap-4">
                    <div class="bg-slate-700/50 p-3 rounded-xl border border-slate-600">
                        <span class="text-xs text-slate-400 block">PML</span>
                        <span class="text-2xl font-bold text-emerald-400"><%= detailedPml.length %></span>
                    </div>
                    <div class="bg-slate-700/50 p-3 rounded-xl border border-slate-600">
                        <span class="text-xs text-slate-400 block">PCL</span>
                        <span class="text-2xl font-bold text-amber-400"><%= detailedPcl.length %></span>
                    </div>
                </div>
                <p class="text-xs text-slate-400">Siap Melaporkan Data Harian</p>
            </div>

        </div>

        <!-- Tabel Rekapitulasi Wilayah Desa / Kalurahan -->
        <div class="bg-slate-800 border border-slate-700 rounded-2xl shadow-lg overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-700">
                <h3 class="text-lg font-bold text-white">📍 Rekapitulasi Per Desa / Kalurahan</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-slate-700/50 text-slate-300 uppercase text-xs tracking-wider border-b border-slate-700">
                            <th class="py-3.5 px-6">Nama Desa</th>
                            <th class="py-3.5 px-6">Target</th>
                            <th class="py-3.5 px-6">Didata</th>
                            <th class="py-3.5 px-6">Capaian</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700">
                        <% if (parsedDesa && parsedDesa.length > 0) { %>
                            <% parsedDesa.forEach(desa => { 
                                let pct = desa.target > 0 ? ((desa.didata / desa.target) * 100).toFixed(1) : 0;
                            %>
                                <tr class="hover:bg-slate-700/30 transition">
                                    <td class="py-4 px-6 font-medium text-white"><%= desa.name %></td>
                                    <td class="py-4 px-6 text-slate-300"><%= desa.target.toLocaleString('id-ID') %></td>
                                    <td class="py-4 px-6 text-slate-300"><%= desa.didata.toLocaleString('id-ID') %></td>
                                    <td class="py-4 px-6">
                                        <div class="flex items-center gap-3">
                                            <span class="font-semibold text-white"><%= pct %>%</span>
                                            <div class="w-24 bg-slate-700 rounded-full h-2 overflow-hidden">
                                                <div class="bg-emerald-500 h-2 rounded-full" style="width: <%= Math.min(pct, 100) %>%"></div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center py-6 text-slate-400">Tidak ada data desa tersedia.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tabel Rekapitulasi Petugas PCL (Responden Didata Murni) -->
        <div class="bg-slate-800 border border-slate-700 rounded-2xl shadow-lg overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-700 flex justify-between items-center">
                <h3 class="text-lg font-bold text-white">📋 Rekapitulasi Petugas PCL (Responden Didata Murni)</h3>
                <span class="text-xs text-slate-400">Total PCL: <%= detailedPcl.length %></span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-slate-700/50 text-slate-300 uppercase text-xs tracking-wider border-b border-slate-700">
                            <th class="py-3.5 px-6">Nama PCL</th>
                            <th class="py-3.5 px-6">Target Prelist</th>
                            <th class="py-3.5 px-6 text-blue-400 font-bold">Responden Didata</th>
                            <th class="py-3.5 px-6">+ Didata (Harian)</th>
                            <th class="py-3.5 px-6">Persentase</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700">
                        <% if (detailedPcl && detailedPcl.length > 0) { %>
                            <% detailedPcl.forEach(pcl => { %>
                                <tr class="hover:bg-slate-700/30 transition">
                                    <td class="py-4 px-6 font-medium text-white"><%= pcl.name %></td>
                                    <td class="py-4 px-6 text-slate-300"><%= pcl.target.toLocaleString('id-ID') %></td>
                                    <td class="py-4 px-6 font-bold text-blue-400"><%= pcl.respondenDidata.toLocaleString('id-ID') %></td>
                                    <td class="py-4 px-6 text-emerald-400 font-semibold">+<%= pcl.harian.toLocaleString('id-ID') %></td>
                                    <td class="py-4 px-6 text-slate-300"><%= pcl.persentase %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-6 text-slate-400">Tidak ada data PCL tersedia.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800 mt-12 py-6 text-center text-xs text-slate-500">
        &copy; 2026 Dashboard Monitoring Pendataan. All rights reserved.
    </footer>

    <!-- Script Kontrol Audio Sirine & Evaluasi Otomatis -->
    <script>
        let audioCtx = null;
        let sirenInterval = null;

        function playSiren() {
            if (sirenInterval) return; 
            document.getElementById('sirenControlPanel').style.display = 'flex';
            
            try {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                sirenInterval = setInterval(() => {
                    if (!audioCtx) return;
                    let osc = audioCtx.createOscillator();
                    let gain = audioCtx.createGain();
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(450, audioCtx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(850, audioCtx.currentTime + 0.3);
                    gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.3);
                }, 400);
            } catch (e) {
                console.error("Audio Context diblokir browser:", e);
            }
        }

        function stopSiren() {
            if (sirenInterval) {
                clearInterval(sirenInterval);
                sirenInterval = null;
            }
            if (audioCtx) {
                audioCtx.close();
                audioCtx = null;
            }
            document.getElementById('sirenControlPanel').style.display = 'none';
        }

        // Jalankan evaluasi harian berdasarkan data total/rata-rata harian PCL
        window.addEventListener('DOMContentLoaded', () => {
            // Contoh validasi ambil nilai total harian baris pertama atau rata-rata
            let sampleHarian = <%= detailedPcl.length > 0 ? detailedPcl[0].harian : 10 %>; 
            const box = document.getElementById('pclHarianBox');
            
            if (sampleHarian >= 10) {
                box.style.backgroundColor = 'rgba(21, 128, 61, 0.85)';
                box.style.borderColor = '#22c55e';
                stopSiren();
            } else {
                box.style.backgroundColor = 'rgba(185, 28, 28, 0.85)';
                box.style.borderColor = '#ef4444';
                playSiren();
            }
        });
    </script>
</body>
</html>
