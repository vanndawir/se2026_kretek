<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitoring Lapangan SE2026 - Kapanewon Kretek</title>
    <style>
        :root {
            --bg-color-start: #ea580c;
            --bg-color-end: #09090b;
            --surface-color: rgba(35, 20, 15, 0.75);
            --surface-card: rgba(50, 25, 20, 0.85);
            --text-main: #f4f4f5;
            --text-muted: #d4d4d8;
            --primary-orange: #fb923c; 
            --border-color: rgba(249, 115, 22, 0.4);
        }

        /* --- SPLASH SCREEN (HALAMAN PEMBUKA) --- */
        #splash-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--bg-color-start) 0%, var(--bg-color-end) 60%);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            transition: opacity 0.8s ease, visibility 0.8s ease;
        }
        .splash-logo {
            width: 28vw;            
            max-width: 280px;      
            min-width: 170px;      
            height: auto;
            aspect-ratio: 1 / 1;   
            object-fit: contain;
            border-radius: 50%;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);
            animation: pulseLogo 2s infinite ease-in-out;
        }
        @keyframes pulseLogo {
            0% { transform: scale(0.95); }
            50% { transform: scale(1.05); }
            100% { transform: scale(0.95); }
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, var(--bg-color-start) 0%, var(--bg-color-end) 60%);
            background-attachment: fixed;
            color: var(--text-main);
            margin: 0;
            padding: 15px;
            min-height: 100vh;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Header & Logos */
        .app-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(35, 20, 15, 0.65);
            border: 1px solid var(--border-color);
            padding: 15px 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.3);
            backdrop-filter: blur(8px);
        }
        .logo-container {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .logo-container img {
            height: 45px;
            width: auto;
            object-fit: contain;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
        }

        .header-title-area {
            text-align: center;
            flex-grow: 1;
            margin: 0 10px;
            overflow: hidden;
        }
        h1 {
            color: #ffffff;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
            margin: 0 0 2px 0;
            font-size: 18px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .title-se {
            color: var(--primary-orange);
            font-size: 16px;
            font-weight: bold;
            margin: 0 0 2px 0;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
        }
        .subtitle {
            color: #f3f4f6;
            font-size: 12px;
            margin: 0 0 5px 0;
            font-weight: 500;
        }

        /* Running Text Styling */
        .running-container {
            width: 100%;
            overflow: hidden;
            white-space: nowrap;
            background: rgba(0, 0, 0, 0.25);
            border-radius: 4px;
            padding: 3px 0;
            box-shadow: inset 0 1px 3px rgba(0,0,0,0.3);
        }
        .running-text {
            display: inline-block;
            padding-left: 100%;
            animation: marquee 16s linear infinite;
            color: #fed7aa;
            font-size: 11px;
            font-weight: bold;
        }
        @keyframes marquee {
            0% { transform: translate(0, 0); }
            100% { transform: translate(-100%, 0); }
        }

        /* Susunan Grid konsisten 2 Kolom di HP dan PC */
        .ranking-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }
        .ranking-card {
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            border-top: 4px solid var(--primary-orange);
            border-radius: 10px;
            padding: 12px 15px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.3);
            backdrop-filter: blur(6px);
        }
        .ranking-card.green-theme {
            border-top-color: #10b981;
        }
        .ranking-card.green-theme h3 {
            color: #34d399;
        }
        .ranking-card h3 {
            margin-top: 0;
            color: var(--primary-orange);
            font-size: 13px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 6px;
        }
        .ranking-list {
            list-style: none;
            padding: 0;
            margin: 8px 0 0 0;
        }
        .ranking-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 5px 0;
            font-size: 12px;
            border-bottom: 1px dashed rgba(255,255,255,0.15);
        }
        .ranking-item:last-child { border-bottom: none; }
        .rank-name { color: var(--text-main); font-weight: 500; }
        .rank-score { color: var(--primary-orange); font-weight: bold; background: rgba(249,115,22,0.2); padding: 2px 6px; border-radius: 4px; }
        .rank-score.green-score { color: #34d399; background: rgba(16,185,129,0.2); }

        .section-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }
        .card {
            background-color: var(--surface-color);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 15px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.3);
            backdrop-filter: blur(6px);
        }
        .card h3 {
            margin-top: 0;
            color: var(--primary-orange);
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 6px;
            font-size: 13px;
        }
        select {
            width: 100%;
            padding: 8px;
            border-radius: 6px;
            background-color: var(--surface-card);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            font-size: 12px;
            margin-bottom: 12px;
            outline: none;
            cursor: pointer;
        }
        select:focus { border-color: var(--primary-orange); }
        .stat-box {
            background-color: var(--surface-card);
            padding: 10px;
            border-radius: 6px;
            margin-top: 8px;
            border: 1px solid var(--border-color);
            max-height: 220px;
            overflow-y: auto;
        }
        .stat-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 6px;
            border-bottom: 1px dashed rgba(255,255,255,0.15);
            padding-bottom: 4px;
            font-size: 12px;
        }
        .stat-label { color: var(--text-muted); }
        .stat-value { font-weight: 600; color: var(--text-main); }
        .badge-progres {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-weight: bold;
            color: #fff;
            font-size: 11px;
        }

        @media(max-width: 480px) {
            body { padding: 8px; }
            .app-header { padding: 10px; }
            .logo-container img { height: 32px; }
            h1 { font-size: 12px; }
            .title-se { font-size: 12px; }
            .subtitle { font-size: 10px; }
            .ranking-card h3, .card h3 { font-size: 11px; }
            .ranking-item, .stat-row, select { font-size: 11px; }
        }
    </style>
</head>
<body>
    <!-- SPLASH SCREEN / GAMBAR PEMBUKA -->
    <div id="splash-screen">
        <img src="/images/logo_kretek.png" alt="Logo Kapanewon Kretek" class="splash-logo">
    </div>

    <div class="container">
        <!-- Header dengan Logo BPS (Kiri) & Logo Sensus Ekonomi (Kanan) -->
        <header class="app-header">
            <div class="logo-container" title="Logo BPS">
                <img src="/images/logo_bps.png" alt="Logo BPS">
            </div>
            <div class="header-title-area">
                <h1>Monitoring Lapangan</h1>
                <div class="title-se">SE2026</div>
                <div class="subtitle">Kapanewon Kretek</div>
                <div class="running-container">
                    <div class="running-text">Data Tanggal: <span><%= activeDate %></span></div>
                </div>
            </div>
            <div class="logo-container" title="Logo Sensus Ekonomi 2026">
                <img src="/images/logo_se.png" alt="Logo Sensus Ekonomi">
            </div>
        </header>

        <!-- Rangking PCL Berdasarkan Progress Harian -->
        <div class="ranking-grid">
            <div class="ranking-card green-theme">
                <h3>🔥 Top 5 PCL (Progress Harian)</h3>
                <ul class="ranking-list">
                    <% if (topPcl && topPcl.length > 0) { %>
                        <% topPcl.forEach((p, i) => { %>
                            <li class="ranking-item">
                                <span class="rank-name"><%= i + 1 %>. <%= p.name || '-' %></span>
                                <span class="rank-score green-score">+<%= p.harian %> Responden</span>
                            </li>
                        <% }) %>
                    <% } else { %>
                        <li class="ranking-item"><span class="rank-name">Belum ada data</span></li>
                    <% } %>
                </ul>
            </div>

            <div class="ranking-card" style="border-top-color: #ef4444;">
                <h3 style="color: #ef4444;">⚠️ 5 PCL (Progress Terendah)</h3>
                <ul class="ranking-list">
                    <% if (bottomPcl && bottomPcl.length > 0) { %>
                        <% bottomPcl.forEach((p, i) => { %>
                            <li class="ranking-item">
                                <span class="rank-name"><%= i + 1 %>. <%= p.name || '-' %></span>
                                <span class="rank-score" style="color: #ef4444; background: rgba(239,68,68,0.2);">+<%= p.harian %> Responden</span>
                            </li>
                        <% }) %>
                    <% } else { %>
                        <li class="ranking-item"><span class="rank-name">Belum ada data</span></li>
                    <% } %>
                </ul>
            </div>
        </div>

        <!-- Detail Wilayah & Petugas -->
        <div class="section-grid">
            <div class="card">
                <h3>Wilayah Kecamatan</h3>
                <select id="selectKec" onchange="updateDetail('kec')">
                    <option value="">-- Pilih Kecamatan --</option>
                    <% kecData.forEach((row, i) => { %>
                        <option value="<%= i %>"><%= row[2] || row[1] || 'Kecamatan ' + (i+1) %></option>
                    <% }) %>
                </select>
                <div id="detailKec" class="stat-box" style="display:none;"></div>
            </div>

            <div class="card">
                <h3>Wilayah Desa</h3>
                <select id="selectDesa" onchange="updateDetail('desa')">
                    <option value="">-- Pilih Desa --</option>
                    <% desaData.forEach((row, i) => { %>
                        <option value="<%= i %>"><%= row[2] || row[1] || 'Desa ' + (i+1) %></option>
                    <% }) %>
                </select>
                <div id="detailDesa" class="stat-box" style="display:none;"></div>
            </div>

            <div class="card">
                <h3>Petugas PML</h3>
                <select id="selectPml" onchange="updateDetail('pml')">
                    <option value="">-- Pilih PML --</option>
                    <% pmlData.forEach((row, i) => { %>
                        <% 
                            let pmlName = '';
                            for (let c = 0; c < row.length; c++) {
                                let val = String(row[c] || '').trim();
                                if (val && isNaN(val) && val.length > 2) {
                                    pmlName = val;
                                    break;
                                }
                            }
                            if (!pmlName) pmlName = row[1] || ('PML ' + (i+1));
                        %>
                        <option value="<%= i %>"><%= pmlName %></option>
                    <% }) %>
                </select>
                <div id="detailPml" class="stat-box" style="display:none;"></div>
            </div>

            <div class="card">
                <h3>Petugas PCL</h3>
                <select id="selectPcl" onchange="updateDetail('pcl')">
                    <option value="">-- Pilih PCL --</option>
                    <% pclData.forEach((row, i) => { %>
                        <% 
                            let pclName = '';
                            for (let c = 0; c < row.length; c++) {
                                let val = String(row[c] || '').trim();
                                if (val && isNaN(val) && val.length > 2) {
                                    pclName = val;
                                    break;
                                }
                            }
                            if (!pclName) pclName = row[1] || ('PCL ' + (i+1));
                        %>
                        <option value="<%= i %>"><%= pclName %></option>
                    <% }) %>
                </select>
                <div id="detailPcl" class="stat-box" style="display:none;"></div>
            </div>
        </div>
    </div>

    <script>
        /* --- SCRIPT UNTUK MENUTUP SPLASH SCREEN SETELAH 2 DETIK --- */
        window.addEventListener('load', () => {
            setTimeout(() => {
                const splash = document.getElementById('splash-screen');
                splash.style.opacity = '0';
                splash.style.visibility = 'hidden';
            }, 2000);
        });

        const dataStore = {
            kec: { headers: <%- JSON.stringify(kecHeaders) %>, rows: <%- JSON.stringify(kecData) %> },
            desa: { headers: <%- JSON.stringify(desaHeaders) %>, rows: <%- JSON.stringify(desaData) %>, harianMap: <%- JSON.stringify(desaHarianMap) %> },
            pml: { headers: <%- JSON.stringify(pmlHeaders) %>, rows: <%- JSON.stringify(pmlData) %>, harianMap: <%- JSON.stringify(pmlHarianMap) %> },
            pcl: { headers: <%- JSON.stringify(pclHeaders) %>, rows: <%- JSON.stringify(pclData) %>, harianMap: <%- JSON.stringify(pclHarianMap) %> }
        };

        function getValueByKeywords(headers, row, keywords) {
            for (let kw of keywords) {
                for (let i = 0; i < headers.length; i++) {
                    const h = headers[i] ? String(headers[i]).toLowerCase() : '';
                    if (h.includes(kw)) {
                        if (kw === 'didata' && h.includes('%')) continue;
                        if (row[i] !== undefined && row[i] !== '' && row[i] !== null) return row[i];
                    }
                }
            }
            return '0';
        }

        function getPercentValue(headers, row) {
            for (let i = 0; i < headers.length; i++) {
                const h = headers[i] ? String(headers[i]).toLowerCase() : '';
                if ((h.includes('%') || h.includes('persen')) && !h.includes('draft')) {
                    if (row[i] !== undefined && row[i] !== '') {
                        let val = String(row[i]).trim();
                        if (!val.includes('%') && !isNaN(val) && val !== '') {
                            let num = parseFloat(val);
                            if (num <= 5) {
                                return (num * 100).toFixed(2) + '%';
                            }
                        }
                        return val;
                    }
                }
            }
            return '0%';
        }

        function getDynamicName(row) {
            if (!row) return '';
            for (let c = 0; c < row.length; c++) {
                let val = String(row[c] || '').trim();
                if (val && isNaN(val) && val.length > 2) {
                    return val;
                }
            }
            return row[1] || '';
        }

        function updateDetail(type) {
            const select = document.getElementById('select' + type.charAt(0).toUpperCase() + type.slice(1));
            const box = document.getElementById('detail' + type.charAt(0).toUpperCase() + type.slice(1));
            const idx = select.value;

            if (idx === "") {
                box.style.display = 'none';
                return;
            }

            box.style.display = 'block';
            const store = dataStore[type];
            const row = store.rows[idx];
            const headers = store.headers;

            let html = '';

            if (type === 'kec') {
                const persen = getPercentValue(headers, row);
                const didata = getValueByKeywords(headers, row, ['responden didata', 'didata']);
                const target = getValueByKeywords(headers, row, ['target', 'prelist']);
                html += `
                    <div class="stat-row"><span class="stat-label">Target Prelist:</span> <span class="stat-value">${target}</span></div>
                    <div class="stat-row"><span class="stat-label">Responden Didata:</span> <span class="stat-value">${didata}</span></div>
                    <div class="stat-row">
                        <span class="stat-label">% Didata</span>
                        <span class="stat-value" style="color: var(--primary-orange); font-size: 15px;">${persen}</span>
                    </div>
                `;
            } else if (type === 'desa') {
                const name = row[2] || row[1] || '';
                const didata = getValueByKeywords(headers, row, ['responden didata', 'didata']);
                const persen = getPercentValue(headers, row);
                const bkuPrelist = getValueByKeywords(headers, row, ['bku prelist', 'prelist']);
                const bkuDitemukan = getValueByKeywords(headers, row, ['bku ditemukan', 'ditemukan']);
                const bkuBaru = getValueByKeywords(headers, row, ['bku baru', 'baru']);
                const totalBku = getValueByKeywords(headers, row, ['total bku']);
                const kelDitemukan = getValueByKeywords(headers, row, ['keluarga ditemukan']);
                const kelBaru = getValueByKeywords(headers, row, ['keluarga baru']);
                const kelTutup = getValueByKeywords(headers, row, ['keluarga tutup', 'tutup']);
                const totalUsaha = getValueByKeywords(headers, row, ['total usaha keluarga', 'usaha keluarga']);
                const harian = store.harianMap && store.harianMap[name] !== undefined ? store.harianMap[name] : 0;

                html += `
                    <div class="stat-row"><span class="stat-label">Responden Didata:</span> <span class="stat-value">${didata}</span></div>
                    <div class="stat-row"><span class="stat-label">+Didata (Harian):</span> <span class="stat-value" style="color: var(--primary-orange);">+${harian}</span></div>
                    <div class="stat-row"><span class="stat-label">% Didata:</span> <span class="stat-value">${persen}</span></div>
                    <div class="stat-row"><span class="stat-label">BKU Prelist:</span> <span class="stat-value">${bkuPrelist}</span></div>
                    <div class="stat-row"><span class="stat-label">BKU Ditemukan:</span> <span class="stat-value">${bkuDitemukan}</span></div>
                    <div class="stat-row"><span class="stat-label">BKU Baru:</span> <span class="stat-value">${bkuBaru}</span></div>
                    <div class="stat-row"><span class="stat-label">Total BKU:</span> <span class="stat-value">${totalBku}</span></div>
                    <div class="stat-row"><span class="stat-label">Keluarga Ditemukan:</span> <span class="stat-value">${kelDitemukan}</span></div>
                    <div class="stat-row"><span class="stat-label">Keluarga Baru:</span> <span class="stat-value">${kelBaru}</span></div>
                    <div class="stat-row"><span class="stat-label">Keluarga Tutup:</span> <span class="stat-value">${kelTutup}</span></div>
                    <div class="stat-row"><span class="stat-label">Total Usaha Keluarga:</span> <span class="stat-value">${totalUsaha}</span></div>
                `;
            } else if (type === 'pcl' || type === 'pml') {
                const name = getDynamicName(row);
                const subSls = row[4] !== undefined && row[4] !== '' ? row[4] : getValueByKeywords(headers, row, ['sub-sls', 'sls']);
                const didata = parseInt(getValueByKeywords(headers, row, ['responden didata', 'didata'])) || 0;
                const targetPrelist = parseInt(getValueByKeywords(headers, row, ['target prelist', 'target'])) || 0;
                const totalBku = parseInt(getValueByKeywords(headers, row, ['total bku'])) || 0;
                const totalUsaha = parseInt(getValueByKeywords(headers, row, ['total usaha keluarga', 'usaha keluarga'])) || 0;
                
                const belumDidata = Math.max(0, targetPrelist - didata);
                const harian = store.harianMap && store.harianMap[name] !== undefined ? store.harianMap[name] : 0;
                const badgeColor = harian >= 10 ? '#10b981' : '#ef4444';

                html += `
                    <div class="stat-row"><span class="stat-label">Sub-SLS Diampu:</span> <span class="stat-value">${subSls}</span></div>
                    <div class="stat-row"><span class="stat-label">Progress Harian (+Didata):</span> <span class="badge-progres" style="background-color: ${badgeColor};">+${harian} Responden</span></div>
                    <div class="stat-row"><span class="stat-label">Target Prelist:</span> <span class="stat-value">${targetPrelist}</span></div>
                    <div class="stat-row"><span class="stat-label">Responden Didata:</span> <span class="stat-value">${didata}</span></div>
                    <div class="stat-row"><span class="stat-label">Belum Didata:</span> <span class="stat-value" style="color: #ef4444; font-weight: bold;">${belumDidata}</span></div>
                    <div class="stat-row"><span class="stat-label">Total BKU:</span> <span class="stat-value">${totalBku}</span></div>
                    <div class="stat-row"><span class="stat-label">Total Usaha Keluarga:</span> <span class="stat-value">${totalUsaha}</span></div>
                `;
            }

            box.innerHTML = html;
        }
    </script>
    <div style="text-align: center; padding: 25px 0 15px 0; color: #f3f4f6; font-size: 12px; opacity: 0.8;">
        Desain &amp; Website by <b>vanndawir</b>
    </div>
</body>
</html>
