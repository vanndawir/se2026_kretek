<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Rekapitulasi Pendataan SE2026 Kretek</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 p-6">
    <div class="container mx-auto">
        <h1 class="text-2xl font-bold mb-4 text-teal-700">Dashboard Rekapitulasi SE2026 - Kretek</h1>
        
        <!-- Contoh Tabel Rekapitulasi Wilayah Desa -->
        <div class="bg-white shadow-md rounded-lg p-4 mb-6">
            <h2 class="text-lg font-semibold mb-2">Rekap Wilayah Desa (File: <%= desaData.filename || 'Tidak ditemukan' %>)</h2>
            <div class="overflow-x-auto">
                <table class="min-w-full border border-gray-300 text-sm">
                    <thead>
                        <% desaData.headers.forEach(headerRow => { %>
                            <tr class="bg-teal-600 text-white text-center">
                                <% headerRow.forEach(th => { %>
                                    <th class="border border-gray-300 px-2 py-1"><%= th %></th>
                                <% }) %>
                            </tr>
                        <% }) %>
                    </thead>
                    <tbody>
                        <% if (desaData.rows.length > 0) { %>
                            <% desaData.rows.forEach(row => { %>
                                <tr class="hover:bg-gray-50">
                                    <% row.forEach(td => { %>
                                        <td class="border border-gray-300 px-2 py-1"><%= td %></td>
                                    <% }) %>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="10" class="text-center py-4 text-gray-500">Tidak ada data.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
