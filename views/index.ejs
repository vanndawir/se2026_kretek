    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        const chatContainer = document.getElementById('chatContainer');
        const chatForm = document.getElementById('chatForm');
        const chatMessage = document.getElementById('chatMessage');
        const chatSender = document.getElementById('chatSender');

        function appendMessage(data) {
            const div = document.createElement('div');
            
            let bgClass = '';
            let badgeText = '';
            let badgeColor = '';

            if (data.sender_type === 'admin') {
                bgClass = 'ml-auto bg-green-950/40 border border-green-500/30 text-right';
                badgeText = '🛡️ ' + data.sender;
                badgeColor = 'text-green-400';
            } else if (data.sender_type === 'ai') {
                bgClass = 'mr-auto bg-sky-950/40 border border-sky-500/30 text-left';
                badgeText = '🤖 ' + data.sender;
                badgeColor = 'text-sky-400';
            } else {
                bgClass = 'mr-auto bg-orange-950/40 border border-orange-500/30 text-left';
                badgeText = '🕵️‍♂️ ' + data.sender;
                badgeColor = 'text-orange-400';
            }

            div.className = `flex flex-col space-y-1 p-2.5 rounded-xl max-w-[85%] ${bgClass}`;
            div.innerHTML = `
                <div class="flex items-center justify-between gap-2 text-[10px] ${badgeColor} font-bold">
                    <span>${badgeText.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</span>
                    <span class="text-slate-500 font-mono">${data.timestamp}</span>
                </div>
                <p class="text-xs text-slate-200 break-words">${data.message.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</p>
            `;
            chatContainer.appendChild(div);
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        socket.on('init_chat', (messages) => {
            chatContainer.innerHTML = '';
            if (messages.length === 0) chatContainer.innerHTML = '<div class="text-center text-slate-500 italic text-xs my-auto">Belum ada curhatan hari ini.</div>';
            else messages.forEach(msg => appendMessage(msg));
        });

        socket.on('new_message', (msg) => {
            if (chatContainer.querySelector('.italic')) chatContainer.innerHTML = '';
            appendMessage(msg);
        });

        chatForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const message = chatMessage.value.trim();
            if (!message) return;

            const nameInput = chatSender.value.trim() || 'Petugas Anonim';
            
            let senderType = 'user';
            if (nameInput.includes('3402030')) {
                senderType = 'admin';
            }

            socket.emit('send_message', { 
                sender: nameInput, 
                message: message,
                sender_type: senderType 
            });
            
            chatMessage.value = '';
        });
    </script>

    <script>
        window.addEventListener('load', () => {
            setTimeout(() => {
                const splash = document.getElementById('welcomeSplash');
                if (splash) {
                    splash.style.opacity = '0';
                    setTimeout(() => {
                        splash.style.display = 'none';
                    }, 700);
                }
            }, 1200);
        });

        const targetDate = new Date('2026-08-17T10:00:00').getTime();

        function updateCountdown() {
            const now = new Date().getTime();
            const distance = targetDate - now;
            const timerEl = document.getElementById('countdownTimer');
            if (!timerEl) return;

            if (distance < 0) {
                timerEl.innerText = "Waktu Tiba!";
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            timerEl.innerText = `${days} Hari ${hours} Jam ${minutes} Menit`;
        }

        setInterval(updateCountdown, 1000);
        updateCountdown();

        const detailedPmlData = <%- JSON.stringify(typeof detailedPml !== 'undefined' && detailedPml ? detailedPml : []) %>;
        const detailedPclData = <%- JSON.stringify(typeof detailedPcl !== 'undefined' && detailedPcl ? detailedPcl : []) %>;

        function parseNum(val) {
            if (typeof val === 'number') {
                val = String(val);
            }
            if (!val) return 0;

            let str = String(val).trim();

            if (str.includes('.') && str.includes(',')) {
                str = str.replace(/\./g, '').replace(',', '.');
            } else if (str.indexOf('.') !== -1) {
                if (/\.\d{3}$/.test(str) || /^\d{1,3}\.\d{3}$/.test(str) || /^\d{1,3}\.\d{3}\.\d{3}$/.test(str)) {
                    str = str.replace(/\./g, '');
                }
            } else if (str.indexOf(',') !== -1) {
                if (/,\d{3}$/.test(str)) {
                    str = str.replace(/,/g, '');
                } else {
                    str = str.replace(',', '.');
                }
            }

            return parseFloat(str) || 0;
        }

        function getFilteredCells(rawCells) {
            if (!rawCells || !Array.isArray(rawCells)) return [];
            const cells = rawCells.slice(-8);
            return cells.filter(cell => {
                const h = (cell.header || '').toLowerCase();
                const isJumlahDidataDraft =
                    (h.includes('jumlah') && h.includes('didata') && h.includes('draft')) ||
                    h.includes('didata + draft') ||
                    h.includes('didata+draft');
                
                const isPersentaseDidataDraft = 
                    h.includes('%') && h.includes('didata') && h.includes('draft');

                return !isJumlahDidataDraft && !isPersentaseDidataDraft;
            });
        }

        const pmlSelect = document.getElementById('pmlSelect');
        const pmlTitle = document.getElementById('pmlSelectedNameTitle');
        const pmlValue = document.getElementById('pmlSelectedValue');
        const pmlSisa = document.getElementById('pmlSisaTargetValue');
        const pmlSisaMob = document.getElementById('pmlSisaTargetValueMobile');
        const pmlPctVal = document.getElementById('pmlPercentageValue');
        const pmlPctBar = document.getElementById('pmlPercentageBar');
        const pmlGrid = document.getElementById('pmlCockpitGrid');
        const pmlPlace = document.getElementById('pmlPlaceholder');
        const pmlCont = document.getElementById('pmlContentContainer');

        const pclSelect = document.getElementById('pclSelect');
        const pclTitle = document.getElementById('pclSelectedNameTitle');
        const pclValue = document.getElementById('pclSelectedValue');
        const pclPctVal = document.getElementById('pclPercentageValue');
        const pclPctBar = document.getElementById('pclPercentageBar');
        const pclProgHarianVal = document.getElementById('pclProgHarianValue');
        const pclSisa = document.getElementById('pclSisaTargetValue');
        const pclSisaMob = document.getElementById('pclSisaTargetValueMobile');
        const pclGrid = document.getElementById('pclCockpitGrid');
        const pclPlace = document.getElementById('pclPlaceholder');
        const pclCont = document.getElementById('pclContentContainer');
        const pclAlarmPanel = document.getElementById('pclAlarmPanel');
        const pclLowWarningBar = document.getElementById('pclLowWarningBar');
        const stopPclAlarmBtn = document.getElementById('stopPclAlarmBtn');

        let emergencyAudioCtx = null;
        let emergencyOscillators = [];
        let emergencyAlarmTimer = null;

        function showPclWarning() {
            if (pclLowWarningBar) {
                pclLowWarningBar.classList.remove('hidden');
            }
        }

        function hidePclWarning() {
            if (pclLowWarningBar) {
                pclLowWarningBar.classList.add('hidden');
            }
        }

        function startEmergencyAlarm() {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;

            if (!emergencyAudioCtx) {
                emergencyAudioCtx = new AudioCtx();
            }

            if (emergencyAudioCtx.state === 'suspended') {
                emergencyAudioCtx.resume();
            }

            if (emergencyOscillators.length > 0) return;

            const masterGain = emergencyAudioCtx.createGain();
            masterGain.gain.value = 0.14;

            const oscA = emergencyAudioCtx.createOscillator();
            oscA.type = 'sawtooth';
            oscA.frequency.value = 950;

            const oscB = emergencyAudioCtx.createOscillator();
            oscB.type = 'square';
            oscB.frequency.value = 1450;

            const lfo = emergencyAudioCtx.createOscillator();
            lfo.type = 'sine';
            lfo.frequency.value = 9;

            const lfoGain = emergencyAudioCtx.createGain();
            lfoGain.gain.value = 340;

            lfo.connect(lfoGain);
            lfoGain.connect(oscA.frequency);
            lfoGain.connect(oscB.frequency);

            oscA.connect(masterGain);
            oscB.connect(masterGain);
            masterGain.connect(emergencyAudioCtx.destination);

            oscA.start();
            oscB.start();
            lfo.start();

            emergencyOscillators = [oscA, oscB, lfo];

            if (emergencyAlarmTimer) clearInterval(emergencyAlarmTimer);

            let direction = 1;
            let current = 950;

            emergencyAlarmTimer = setInterval(() => {
                if (!emergencyOscillators.length) return;

                current += direction * 140;

                if (current >= 1500 || current <= 700) {
                    direction *= -1;
                    current = Math.max(700, Math.min(1500, current));
                }

                oscA.frequency.setTargetAtTime(current, emergencyAudioCtx.currentTime, 0.06);
                oscB.frequency.setTargetAtTime(current * 1.55, emergencyAudioCtx.currentTime, 0.06);
            }, 80);
        }

        function stopEmergencyAlarm() {
            if (emergencyAlarmTimer) {
                clearInterval(emergencyAlarmTimer);
                emergencyAlarmTimer = null;
            }

            emergencyOscillators.forEach((osc) => {
                try { osc.stop(); } catch (e) {}
            });
            emergencyOscillators = [];

            if (emergencyAudioCtx) {
                try { emergencyAudioCtx.close(); } catch (e) {}
                emergencyAudioCtx = null;
            }
        }

        function showPclAlarm() {
            if (pclAlarmPanel) pclAlarmPanel.classList.add('active');
        }

        function hidePclAlarm() {
            if (pclAlarmPanel) pclAlarmPanel.classList.remove('active');
        }

        function applyPclStatusByProgress(progressPercent, plusDidata) {
            if (!pclPctVal || !pclPctBar || !pclProgHarianVal) return;

            const plus = Number(plusDidata) || 0;
            const progress = Number(progressPercent) || 0;

            pclPctVal.classList.remove('status-positive', 'status-negative', 'pcl-progress-default');
            pclPctBar.classList.remove('status-positive-bar', 'status-negative-bar', 'pcl-progress-bar');
            pclProgHarianVal.classList.remove('plus-data-ok', 'plus-data-low', 'plus-data-static');

            pclPctVal.classList.add('pcl-progress-default');
            pclPctBar.classList.add('pcl-progress-bar');

            if (progress >= 100) {
                pclProgHarianVal.classList.add('plus-data-ok');
                hidePclWarning();
                hidePclAlarm();
                stopEmergencyAlarm();
                return;
            }

            if (plus >= 10) {
                pclProgHarianVal.classList.add('plus-data-ok');
                hidePclWarning();
                hidePclAlarm();
                stopEmergencyAlarm();
                return;
            }

            pclProgHarianVal.classList.add('plus-data-low');
            showPclWarning();
            showPclAlarm();
            startEmergencyAlarm();
        }

        if (stopPclAlarmBtn) {
            stopPclAlarmBtn.addEventListener('click', () => {
                hidePclAlarm();
                stopEmergencyAlarm();

                if (pclProgHarianVal) {
                    pclProgHarianVal.classList.remove('plus-data-ok');
                    pclProgHarianVal.classList.add('plus-data-low');
                }

                if (pclPctVal && pclPctBar) {
                    pclPctVal.classList.remove('pcl-progress-default');
                    pclPctVal.classList.add('pcl-progress-default');
                    pclPctBar.classList.remove('pcl-progress-bar');
                    pclPctBar.classList.add('pcl-progress-bar');
                }

                showPclWarning();
            });
        }

        function closePclCard() {
            if (pclSelect) pclSelect.value = '';
            if (pclPlace) pclPlace.classList.remove('hidden');
            if (pclCont) pclCont.classList.add('hidden');
            hidePclAlarm();
            hidePclWarning();
            stopEmergencyAlarm();
        }

        function closePmlCard() {
            if (pmlSelect) pmlSelect.value = '';
            if (pmlPlace) pmlPlace.classList.remove('hidden');
            if (pmlCont) pmlCont.classList.add('hidden');
        }

        if (pmlSelect) {
            const renderPmlCard = (index) => {
                const item = detailedPmlData[index];
                if (!item) return;

                pmlPlace.classList.add('hidden');
                pmlCont.classList.remove('hidden');

                closePclCard();

                let didataVal = parseNum(item.didata ?? item.respondenDidata ?? 0);
                let targetPrelistVal = parseNum(item.targetPrelist ?? item.target ?? 0);

                let draftPctRaw = item.progressDraftVal || 0;
                let draftPctStr = item.progressDraft || '0%';

                if (item.rawCells && Array.isArray(item.rawCells)) {
                    item.rawCells.forEach((cell) => {
                        const hLower = (cell.header || '').toLowerCase();
                        const cValNum = parseNum(cell.value);

                        if (
                            (hLower.includes('didata') || hLower.includes('realisasi')) &&
                            !hLower.includes('target') &&
                            !hLower.includes('prelist') &&
                            !hLower.includes('draft') &&
                            !hLower.includes('+didata')
                        ) {
                            if (didataVal === 0) didataVal = cValNum;
                        }

                        if (
                            (hLower.includes('target') || hLower.includes('beban') || hLower.includes('sasaran')) &&
                            (hLower.includes('prelist') || hLower.includes('pre-list') || hLower.includes('awal'))
                        ) {
                            targetPrelistVal = cValNum;
                        }
                    });
                }

                let gridHtml = '';
                if (item.rawCells && Array.isArray(item.rawCells)) {
                    const cells = getFilteredCells(item.rawCells).sort((a, b) => {
                        const ha = (a.header || '').toLowerCase();
                        const hb = (b.header || '').toLowerCase();
                        if (ha.includes('target') && !ha.includes('prelist')) return -1;
                        if (hb.includes('target') && !ha.includes('prelist')) return 1;
                        if (ha.includes('didata') || ha.includes('usaha')) return -1;
                        if (hb.includes('didata') || hb.includes('usaha')) return 1;
                        return ha.localeCompare(hb);
                    });

                    cells.forEach((cell) => {
                        const header = cell.header || 'Label';
                        const cVal = cell.value || 0;
                        gridHtml += `
                            <div class="bg-black/90 p-3 rounded-xl border border-slate-800 flex justify-between items-center shadow">
                                <span class="text-[10px] font-bold text-slate-300 uppercase tracking-wider">${header}</span>
                                <span class="text-xs sm:text-sm font-black font-mono-telemetry text-white">${typeof cVal === 'number' ? cVal.toLocaleString('id-ID') : cVal}</span>
                            </div>
                        `;
                    });
                }
                pmlTitle.innerText = item.name || '—';
                pmlValue.innerText = didataVal.toLocaleString('id-ID');

                const pmlPct = targetPrelistVal > 0 ? (didataVal / targetPrelistVal) * 100 : 0;
                pmlPctVal.innerText = `${pmlPct.toFixed(1)}%`;
                pmlPctBar.style.height = `${Math.min(Math.max(pmlPct, 0), 100)}%`;

                const pmlDraftPctValEl = document.getElementById('pmlDraftPercentageValue');
                const pmlDraftPctBarEl = document.getElementById('pmlDraftPercentageBar');
                if (pmlDraftPctValEl) pmlDraftPctValEl.innerText = draftPctStr;
                if (pmlDraftPctBarEl) pmlDraftPctBarEl.style.height = `${Math.min(Math.max(draftPctRaw, 0), 100)}%`;

                const pmlTargetPrelist = Math.max(targetPrelistVal, 0);
                pmlSisa.innerText = pmlTargetPrelist.toLocaleString('id-ID');
                if (pmlSisaMob) pmlSisaMob.innerText = pmlTargetPrelist.toLocaleString('id-ID');

                pmlSisa.classList.add('target-static');
                if (pmlSisaMob) pmlSisaMob.classList.add('target-static');

                pmlGrid.innerHTML = gridHtml || '<div class="col-span-full text-center text-xs text-slate-500 italic">Tidak ada rincian data</div>';
            };

            pmlSelect.addEventListener('change', () => {
                const val = pmlSelect.value;
                if (val === '') {
                    pmlPlace.classList.remove('hidden');
                    pmlCont.classList.add('hidden');
                    return;
                }
                renderPmlCard(parseInt(val, 10));
            });

            if (pmlSelect.options.length > 1) {
                pmlSelect.value = pmlSelect.options[1].value;
                renderPmlCard(parseInt(pmlSelect.value, 10));
            }
        }

        if (pclSelect) {
            const renderPclCard = (index) => {
                const item = detailedPclData[index];
                if (!item) return;

                pclPlace.classList.add('hidden');
                pclCont.classList.remove('hidden');

                closePmlCard();

                let didataVal = parseNum(item.didata ?? item.respondenDidata ?? 0);
                let targetPrelistVal = parseNum(item.targetPrelist ?? item.target ?? 0);

                let draftPctRaw = item.progressDraftVal || 0;
                let draftPctStr = item.progressDraft || '0%';

                if (item.rawCells && Array.isArray(item.rawCells)) {
                    item.rawCells.forEach((cell) => {
                        const hLower = (cell.header || '').toLowerCase();
                        const cValNum = parseNum(cell.value);

                        if (
                            (hLower.includes('didata') || hLower.includes('realisasi')) &&
                            !hLower.includes('target') &&
                            !hLower.includes('prelist') &&
                            !hLower.includes('draft') &&
                            !hLower.includes('+didata')
                        ) {
                            if (didataVal === 0) didataVal = cValNum;
                        }

                        if (
                            (hLower.includes('target') || hLower.includes('beban') || hLower.includes('sasaran')) &&
                            (hLower.includes('prelist') || hLower.includes('pre-list') || hLower.includes('awal'))
                        ) {
                            targetPrelistVal = cValNum;
                        }
                    });
                }

                let gridHtml = '';
                if (item.rawCells && Array.isArray(item.rawCells)) {
                    const cells = getFilteredCells(item.rawCells).sort((a, b) => {
                        const ha = (a.header || '').toLowerCase();
                        const hb = (b.header || '').toLowerCase();
                        if (ha.includes('target') && !ha.includes('prelist')) return -1;
                        if (hb.includes('target') && !hb.includes('prelist')) return 1;
                        if (ha.includes('didata') || ha.includes('usaha')) return -1;
                        if (hb.includes('didata') || hb.includes('usaha')) return 1;
                        return ha.localeCompare(hb);
                    });

                    cells.forEach((cell) => {
                        const header = cell.header || 'Label';
                        const cVal = cell.value || 0;
                        gridHtml += `
                            <div class="bg-black/90 p-3 rounded-xl border border-slate-800 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-1.5 shadow">
                                <span class="text-[10px] font-bold text-slate-300 uppercase tracking-wider">${header}</span>
                                <span class="text-xs sm:text-sm font-black font-mono-telemetry text-white">${typeof cVal === 'number' ? cVal.toLocaleString('id-ID') : cVal}</span>
                            </div>
                        `;
                    });
                }

                pclTitle.innerText = item.name || '—';
                pclValue.innerText = didataVal.toLocaleString('id-ID');

                const pclPct = targetPrelistVal > 0 ? (didataVal / targetPrelistVal) * 100 : 0;
                pclPctVal.innerText = `${pclPct.toFixed(1)}%`;
                pclPctBar.style.height = `${Math.min(Math.max(pclPct, 0), 100)}%`;

                const pclDraftPctValEl = document.getElementById('pclDraftPercentageValue');
                const pclDraftPctBarEl = document.getElementById('pclDraftPercentageBar');
                if (pclDraftPctValEl) pclDraftPctValEl.innerText = draftPctStr;
                if (pclDraftPctBarEl) pclDraftPctBarEl.style.height = `${Math.min(Math.max(draftPctRaw, 0), 100)}%`;

                let plusDidata = item.harian || 0;
                pclProgHarianVal.innerText = `+${plusDidata}`;

                const pclTargetPrelist = Math.max(targetPrelistVal, 0);
                pclSisa.innerText = pclTargetPrelist.toLocaleString('id-ID');
                if (pclSisaMob) pclSisaMob.innerText = pclTargetPrelist.toLocaleString('id-ID');
                pclSisa.classList.add('target-static');
                if (pclSisaMob) pclSisaMob.classList.add('target-static');

                pclGrid.innerHTML = gridHtml || '<div class="col-span-full text-center text-xs text-slate-500 italic">Tidak ada rincian data</div>';

                applyPclStatusByProgress(pclPct, plusDidata);
            };

            pclSelect.addEventListener('change', () => {
                const val = pclSelect.value;
                if (val === '') {
                    pclPlace.classList.remove('hidden');
                    pclCont.classList.add('hidden');
                    hidePclWarning();
                    hidePclAlarm();
                    stopEmergencyAlarm();
                    return;
                }
                renderPclCard(parseInt(val, 10));
            });

            if (pclSelect.options.length > 1) {
                pclSelect.value = pclSelect.options[1].value;
                renderPclCard(parseInt(pclSelect.value, 10));
            }
        }
    </script>
</body>
</html>