<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitoring Lapangan SE2026 - Kapanewon Kretek</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@700;800&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: linear-gradient(135deg, #090d16 0%, #171f2f 50%, #1a1006 100%);
            min-height: 100vh;
        }
        .font-mono-telemetry {
            font-family: 'JetBrains Mono', monospace;
        }
        .glass-card { 
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.85) 0%, rgba(20, 27, 43, 0.9) 100%); 
            backdrop-filter: blur(12px); 
            border: 1px solid rgba(249, 115, 22, 0.25); 
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        }
        @keyframes blink-fast {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.15; }
        }
        .animate-blink {
            animation: blink-fast 0.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
    </style>
</head>
<body class="text-slate-100 min-h-screen antialiased selection:bg-orange-500 selection:text-white overflow-x-hidden">

    <!-- Splash Screen -->
    <div id="welcomeSplash" class="fixed inset-0 z-[100] bg-gradient-to-b from-orange-600 via-orange-950 to-black flex flex-col items-center justify-center transition-opacity duration-700">
        <img src="/images/logo_kretek.png" alt="Logo Kapanewon Kretek" class="h-44 sm:h-60 w-auto object-contain animate-pulse drop-shadow-2xl" onerror="this.style.display='none'">
    </div>

    <!-- Header -->
    <header class="glass-card sticky top-0 z-50 border-b border-orange-500/30 shadow-2xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-24 flex items-center justify-between">
            <div class="flex items-center space-x-3.5 flex-shrink-0">
                <img src="/images/logo_bps.png" alt="Logo BPS" class="h-12 sm:h-14 w-auto object-contain drop-shadow" onerror="this.style.display='none'">
                <div class="hidden sm:block border-l border-slate-700/80 pl-3.5">
                    <span class="block text-xs uppercase tracking-widest text-orange-400 font-bold">Kapanewon</span>
                    <span class="text-base sm:text-lg font-extrabold tracking-tight bg-gradient-to-r from-orange-400 to-amber-200 bg-clip-text text-transparent">Kretek</span>
                </div>
            </div>

            <div class="flex-1 text-center px-2">
                <h1 class="text-xs sm:text-base font-extrabold tracking-tight text-white uppercase drop-shadow">Monitoring Lapangan SE2026</h1>
                <div class="mt-1">
                    <span class="inline-block text-xs font-extrabold text-amber-300 tracking-wider bg-orange-950/40 px-3 py-0.5 rounded-full border border-orange-500/30">
                        📅 Update Data Tanggal: <%= typeof activeDate !== 'undefined' ? activeDate : '-' %>
                    </span>
                </div>
            </div>

            <div class="flex items-center flex-shrink-0 bg-white px-2.5 py-1.5 rounded-xl shadow-lg border border-slate-300">
                <img src="/images/logo_se.png" alt="Logo SE" class="h-9 sm:h-11 w-auto object-contain" onerror="this.style.display='none'">
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-5 sm:py-8 space-y-6">

        <!-- Top Banner -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
            <div class="rounded-2xl shadow-2xl overflow-hidden border-2 border-red-500/80 flex flex-col sm:flex-row items-center justify-between relative">
                <div class="absolute inset-0 flex flex-col w-full h-full pointer-events-none z-0">
                    <div class="w-full h-1/2 bg-red-600"></div>
                    <div class="w-full h-1/2 bg-white"></div>
                </div>

                <div class="relative z-10 p-5 sm:p-6 flex flex-col justify-center w-full sm:w-auto">
                    <div class="flex items-center space-x-2 mb-1.5">
                        <span class="inline-block w-2.5 h-2.5 rounded-full bg-white animate-ping shadow-md"></span>
                        <span class="text-[10px] font-black text-white tracking-wider uppercase font-mono bg-black/40 px-2 py-0.5 rounded shadow">1945 - 2026</span>
                    </div>
                    <h2 class="text-sm sm:text-base font-black text-slate-900 tracking-wide uppercase bg-white/90 px-3 py-1.5 rounded-xl border border-red-300 shadow-md inline-block w-fit">Kemerdekaan Indonesia</h2>
                </div>

                <div class="relative z-10 p-5 sm:p-6 flex items-center justify-end w-full sm:w-auto">
                    <div class="bg-black/95 px-4 sm:px-5 py-2.5 sm:py-3 rounded-xl border-2 border-red-500 shadow-[0_0_25px_rgba(220,38,38,0.5)] text-center relative">
                        <div class="absolute -top-2.5 left-1/2 transform -translate-x-1/2 bg-red-600 text-white text-[8px] font-black px-2 py-0.5 rounded uppercase tracking-widest shadow">HUT RI 81</div>
                        <div id="countdownTimer" class="text-base sm:text-lg font-black text-white tracking-wider font-mono drop-shadow-[0_0_8px_rgba(255,255,255,0.8)]">00 Hari 00 Jam</div>
                        <span class="text-[9px] text-slate-200 uppercase tracking-widest font-extrabold">Detik detik Proklamasi</span>
                    </div>
                </div>
            </div>

            <div class="glass-card rounded-2xl p-5 sm:p-6 shadow-2xl border-l-4 border-l-orange-500 flex items-center justify-between gap-3 sm:gap-4 bg-gradient-to-r from-slate-900/90 via-slate-900/80 to-orange-950/30">
                <h2 class="text-sm sm:text-lg font-extrabold text-white tracking-wide uppercase">Capaian Pendataan Lapangan</h2>
                <div class="bg-black/90 px-4 sm:px-5 py-2.5 sm:py-3 rounded-2xl border-2 border-orange-500/60 shadow-[0_0_20px_rgba(249,115,22,0.4)] flex items-center space-x-3">
                    <div class="text-right">
                        <span class="block text-[9px] text-orange-400 uppercase tracking-widest font-black">Live Gauge</span>
                        <span class="text-2xl sm:text-3xl font-black text-orange-400 tracking-tighter drop-shadow-[0_0_8px_rgba(249,115,22,0.8)]"><%= typeof persentaseKretek !== 'undefined' ? persentaseKretek : '0' %>%</span>
                    </div>
                    <div class="w-3 h-8 bg-orange-500/20 rounded-full overflow-hidden flex flex-col justify-end border border-orange-400/80">
                        <div class="w-full bg-orange-500 animate-pulse shadow-[0_0_10px_#f97316]" style="height: <%= Math.min(Math.max(parseFloat(typeof persentaseKretek !== 'undefined' ? persentaseKretek : 0), 0), 100) %>%;"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Menu Ruang Santai / TikTok Petugas -->
        <div class="glass-card rounded-2xl p-4 sm:p-5 shadow-xl border border-orange-500/30 flex flex-col sm:flex-row items-center justify-between gap-4 bg-gradient-to-r from-slate-900/90 via-orange-950/20 to-slate-900/90">
            <div class="text-center sm:text-left">
                <span class="text-[10px] font-bold uppercase tracking-wider text-orange-400">Ruang Motivasi & Relaksasi Petugas</span>
                <h2 class="text-sm sm:text-base font-extrabold text-white mt-0.5">Butuh Dorongan Semangat atau Lagi Lelah / Galau?</h2>
            </div>
            <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3">
    <a href="https://www.tiktok.com/@parangrockers/video/7645650383875886356?is_from_webapp=1&sender_device=pc&web_id=7668942723827959313" target="_blank" class="flex-1 sm:flex-none text-center bg-gradient-to-r from-orange-600 to-amber-600 hover:from-orange-500 hover:to-amber-500 text-white text-xs font-bold px-3.5 py-2.5 rounded-xl shadow-lg border border-orange-400/50 flex items-center justify-center space-x-2 transition transform hover:scale-105">
        <span>🔥 Saat Butuh Semangat</span>
        <span class="text-amber-200 animate-pulse">👉</span>
    </a>
    <a href="https://www.tiktok.com/@parangrockers/video/7654901051283229972?is_from_webapp=1&sender_device=pc&web_id=7668942723827959313" target="_blank" class="flex-1 sm:flex-none text-center bg-gradient-to-r from-slate-800 to-slate-900 hover:from-slate-700 hover:to-slate-800 text-amber-300 text-xs font-bold px-3.5 py-2.5 rounded-xl shadow-lg border border-slate-700 flex items-center justify-center space-x-2 transition transform hover:scale-105">
        <span>☕ Saat Galau & Lelah</span>
        <span class="text-amber-400 animate-pulse">👉</span>
    </a>
</div>
        </div>

        <!-- Rekapitulasi Wilayah Desa -->
        <div class="glass-card rounded-2xl p-4 sm:p-6 shadow-xl border-t-4 border-t-amber-500 flex flex-col space-y-4">
            <div class="flex justify-between items-center">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-amber-400">Rekapitulasi Wilayah Desa</p>
                    <h2 class="text-base font-extrabold text-white mt-0.5">Progress per Desa / Kalurahan</h2>
                </div>
                <span class="bg-amber-500/20 text-amber-300 text-xs font-bold px-3 py-1 rounded-full border border-amber-500/30">
                    Total Desa: <%= (typeof parsedDesa !== 'undefined' && parsedDesa) ? parsedDesa.length : 0 %>
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <% if (typeof parsedDesa === 'undefined' || !parsedDesa || parsedDesa.length === 0) { %>
                    <div class="col-span-full py-8 text-center text-slate-400 italic bg-slate-950/40 rounded-xl border border-slate-800">Tidak ada data desa tersedia</div>
                <% } else { %>
                    <% parsedDesa.forEach(desa => { %>
                        <% const pct = desa.target > 0 ? ((desa.didata / desa.target) * 100) : 0; %>
                        <div class="p-4 rounded-xl border border-slate-700 bg-gradient-to-br from-gray-900 via-black to-gray-900 shadow-[inset_0_0_20px_rgba(255,255,255,0.05),_0_10px_20px_rgba(0,0,0,0.5)] relative overflow-hidden">
                            <div class="absolute inset-0 opacity-20" style="background-image: repeating-linear-gradient(45deg, #000 25%, transparent 25%, transparent 75%, #000 75%, #000), repeating-linear-gradient(45deg, #000 25%, #1a1a1a 25%, #1a1a1a 75%, #000 75%, #000); background-position: 0 0, 4px 4px; background-size: 8px 8px;"></div>
                            <div class="relative z-10 flex flex-col space-y-3">
                                <div class="flex justify-between items-center border-b border-slate-800 pb-2">
                                    <span class="text-xs font-black uppercase text-orange-400 tracking-wider"><%= desa.name %></span>
                                    <div class="flex items-center space-x-1">
                                        <div class="w-2.5 h-1.5 bg-green-500 skew-x-[15deg] shadow-[0_0_4px_#22c55e]"></div>
                                        <div class="w-2.5 h-1.5 bg-green-500 skew-x-[15deg] shadow-[0_0_4px_#22c55e]"></div>
                                        <div class="w-2.5 h-1.5 bg-yellow-400 skew-x-[15deg] shadow-[0_0_4px_#facc15]"></div>
                                        <div class="w-2.5 h-1.5 bg-red-600 skew-x-[15deg] animate-pulse shadow-[0_0_6px_#dc2626]"></div>
                                    </div>
                                </div>
                                <div class="flex justify-between items-end">
                                    <div>
                                        <span class="block text-[8px] font-mono-telemetry text-slate-400 uppercase tracking-widest">Didata / Target</span>
                                        <div class="flex items-baseline space-x-1 mt-0.5">
                                            <span class="text-2xl sm:text-3xl font-black text-white italic font-mono-telemetry tracking-tighter"><%= (desa.didata || 0).toLocaleString('id-ID') %></span>
                                            <span class="text-xs font-bold text-slate-400 font-mono-telemetry">/ <%= (desa.target || 0).toLocaleString('id-ID') %></span>
                                        </div>
                                    </div>
                                    <div class="bg-black/90 px-3 py-1.5 rounded-xl border border-amber-500/50 shadow-[0_0_12px_rgba(245,158,11,0.3)] text-center flex items-center space-x-2">
                                        <div class="text-right">
                                            <span class="block text-[8px] font-mono-telemetry tracking-widest text-amber-400 uppercase font-black">Capaian</span>
                                            <span class="text-xs font-black font-mono-telemetry text-amber-300"><%= pct.toFixed(1) %>%</span>
                                        </div>
                                        <div class="w-2.5 h-5 bg-amber-500/20 rounded-full overflow-hidden flex flex-col justify-end border border-amber-400/60">
                                            <div class="w-full bg-amber-400 animate-pulse shadow-[0_0_6px_#fbbf24]" style="height: <%= Math.min(Math.max(pct, 0), 100) %>%;"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>

        <!-- Section Petugas PML & PCL -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6">

            <!-- Petugas PML Card -->
            <div class="glass-card rounded-2xl p-4 sm:p-6 shadow-xl border-t-4 border-t-amber-500 flex flex-col space-y-4">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-amber-400">Petugas PML</p>
                    <h2 class="text-base font-extrabold text-white mt-0.5">Pilih Nama untuk Rincian</h2>
                </div>

                <div>
                    <select id="pmlSelect" class="w-full bg-slate-900/90 border border-slate-700 text-white text-sm font-semibold rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer shadow-inner">
                        <option value="" selected>-- Pilih Petugas PML --</option>
                        <% if (typeof detailedPml !== 'undefined' && detailedPml) { %>
                            <% detailedPml.forEach((p, idx) => { %>
                                <% const pmlName = (p.name || '').trim().toLowerCase(); %>
                                <% if (pmlName && !pmlName.includes('target') && !pmlName.includes('prelit') && !pmlName.includes('prelist')) { %>
                                    <option value="<%= idx %>"><%= p.name %></option>
                                <% } %>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div id="pmlPlaceholder" class="py-8 text-center text-xs text-slate-400 italic bg-slate-950/40 rounded-xl border border-slate-800/80">
                    Silakan pilih nama PML untuk menampilkan rincian data
                </div>

                <!-- Konten Rincian Dashboard PML -->
                <div id="pmlContentContainer" class="space-y-3.5 hidden">
                    <div class="p-3 sm:p-5 rounded-xl border border-slate-700 bg-gradient-to-br from-gray-900 via-black to-gray-900 shadow-[inset_0_0_20px_rgba(255,255,255,0.05),_0_10px_20px_rgba(0,0,0,0.5)] flex-row justify-between items-start sm:items-center gap-3 relative overflow-hidden">
                        <div class="absolute inset-0 opacity-20" style="background-image: repeating-linear-gradient(45deg, #000 25%, transparent 25%, transparent 75%, #000 75%, #000), repeating-linear-gradient(45deg, #000 25%, #1a1a1a 25%, #1a1a1a 75%, #000 75%, #000); background-position: 0 0, 4px 4px; background-size: 8px 8px;"></div>
                        
                        <div class="relative z-10 flex flex-col justify-center">
                            <div class="flex items-center space-x-1 sm:space-x-1.5 mb-1 sm:mb-2">
                                <div class="w-3 sm:w-4 h-1.5 bg-green-500 skew-x-[15deg] shadow-[0_0_6px_#22c55e]"></div>
                                <div class="w-3 sm:w-4 h-1.5 bg-green-500 skew-x-[15deg] shadow-[0_0_6px_#22c55e]"></div>
                                <div class="w-3 sm:w-4 h-1.5 bg-green-500 skew-x-[15deg] shadow-[0_0_6px_#22c55e]"></div>
                                <div class="w-3 sm:w-4 h-1.5 bg-yellow-400 skew-x-[15deg] shadow-[0_0_6px_#facc15]"></div>
                                <div class="w-3 sm:w-4 h-1.5 bg-yellow-400 skew-x-[15deg] shadow-[0_0_6px_#facc15]"></div>
                                <div class="w-3 sm:w-4 h-1.5 bg-red-600 skew-x-[15deg] animate-pulse shadow-[0_0_10px_#dc2626]"></div>
                                <span class="ml-2 text-[8px] sm:text-[10px] font-mono-telemetry font-black text-slate-300 tracking-widest uppercase">RSP. DIDATA</span>
                            </div>
                            
                            <div class="flex items-baseline">
                                <h3 id="pmlSelectedNameTitle" class="text-5xl sm:text-6xl font-black text-white italic tracking-tighter drop-shadow-[0_0_15px_rgba(255,255,255,0.4)] font-mono-telemetry" style="line-height: 0.85;">0</h3>
                            </div>
                        </div>

                        <div class="flex items-center space-x-2 relative z-10">
                            <div class="bg-black/90 px-3 py-2 rounded-xl border border-amber-500/50 shadow-[0_0_12px_rgba(245,158,11,0.3)] text-center flex items-center space-x-2">
                                <div class="text-right">
                                    <span class="block text-[8px] font-mono-telemetry tracking-widest text-amber-400 uppercase font-black">Progress</span>
                                    <span id="pmlPercentageValue" class="text-xs sm:text-sm font-black font-mono-telemetry text-amber-300">0%</span>
                                </div>
                                <div class="w-2.5 h-6 bg-amber-500/20 rounded-full overflow-hidden flex flex-col justify-end border border-amber-400/60">
                                    <div id="pmlPercentageBar" class="w-full bg-amber-400 animate-pulse shadow-[0_0_8px_#fbbf24]" style="height: 0%;"></div>
                                </div>
                            </div>
                            <div class="bg-black/90 px-3.5 py-1.5 rounded-xl border border-red-500/50 shadow-[0_0_15px_rgba(239,68,68,0.3)] text-right hidden sm:block">
                                <span class="block text-[8px] font-mono-telemetry tracking-widest text-red-400 uppercase font-black">Sisa Target</span>
                                <span id="pmlSisaTargetValue" class="text-xl sm:text-2xl font-black font-mono-telemetry animate-blink text-red-500 drop-shadow-[0_0_10px_rgba(239,68,68,0.9)]">0</span>
                            </div>
                        </div>
                    </div>

                    <div class="sm:hidden bg-black/90 px-3.5 py-1.5 rounded-xl border border-red-500/50 shadow-[0_0_15px_rgba(239,68,68,0.3)] text-center">
                        <span class="block text-[8px] font-mono-telemetry tracking-widest text-red-400 uppercase font-black">Sisa Target</span>
                        <span id="pmlSisaTargetValueMobile" class="text-xl font-black font-mono-telemetry animate-blink text-red-500 drop-shadow-[0_0_10px_rgba(239,68,68,0.9)]">0</span>
                    </div>

                    <div id="pmlCockpitGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5"></div>
                </div>
            </div>

            <!-- Petugas PCL Card -->
            <div class="glass-card rounded-2xl p-4 sm:p-6 shadow-xl border-t-4 border-t-amber-500 flex flex-col space-y-4">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-amber-400">Petugas PCL</p>
                    <h2 class="text-base font-extrabold text-white mt-0.5">Pilih Nama untuk Rincian</h2>
                </div>

                <div>
                    <select id="pclSelect" class="w-full bg-slate-900/90 border border-slate-700 text-white text-sm font-semibold rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer shadow-inner">
                        <option value="" selected>-- Pilih Petugas PCL --</option>
                        <% if (typeof detailedPcl !== 'undefined' && detailedPcl) { %>
                            <% detailedPcl.forEach((p, idx) => { %>
                                <% const pclName = (p.name || '').trim().toLowerCase(); %>
                                <% if (pclName && !pclName.includes('target') && !pclName.includes('prelit') && !pclName.includes('prelist')) { %>
                                    <option value="<%= idx %>"><%= p.name %></option>
                                <% } %>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div id="pclPlaceholder" class="py-8 text-center text-xs text-slate-400 italic bg-slate-950/40 rounded-xl border border-slate-800/80">
                    Silakan pilih nama PCL untuk menampilkan rincian data
                </div>

                <!-- Konten Rincian PCL -->
                <div id="pclContentContainer" class="space-y-3.5 hidden">
                    <div class="p-3 sm:p-5 rounded-xl border border-slate-700 bg-gradient-to-br from-gray-900 via-black to-gray-900 shadow-[inset_0_0_20px_rgba(255,255,255,0.05),_0_10px_20px_rgba(0,0,0,0.5)] flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 relative overflow-hidden">
                        
                        <div class="relative z-10 flex flex-col justify-center">
                            <div class="flex items-center space-x-1 sm:space-x-1.5 mb-1 sm:mb-2">
                                <div class="w-3 sm:w-4 h-1.5 bg-green-500 skew-x-[15deg] shadow-[0_0_6px_#22c55e]"></div>
                                <div class="w-3 sm:w-4 h-1.5 bg-green-500 skew-x-[15deg] shadow-[0_0_6px_#22c55e]"></div>
                                <div class="w-3 sm:w-4 h-1.5 bg-green-500 skew-x-[15deg] shadow-[0_0_6px_#22c55e]"></div>
                                <div class="w-3 sm:w-4 h-1.5 bg-yellow-400 skew-x-[15deg] shadow-[0_0_6px_#facc15]"></div>
                                <div class="w-3 sm:w-4 h-1.5 bg-yellow-400 skew-x-[15deg] shadow-[0_0_6px_#facc15]"></div>
                                <div class="w-3 sm:w-4 h-1.5 bg-red-600 skew-x-[15deg] animate-pulse shadow-[0_0_10px_#dc2626]"></div>
                                <span class="ml-2 text-[8px] sm:text-[10px] font-mono-telemetry font-black text-slate-300 tracking-widest uppercase">RSP. DIDATA</span>
                            </div>
                            
                            <div class="flex items-baseline">
                                <h3 id="pclSelectedNameTitle" class="text-5xl sm:text-6xl font-black text-white italic tracking-tighter drop-shadow-[0_0_15px_rgba(255,255,255,0.4)] font-mono-telemetry" style="line-height: 0.85;">0</h3>
                            </div>
                        </div>

                        <div class="flex items-center space-x-2 relative z-10">
                            <div class="bg-black/90 px-3 py-2 rounded-xl border border-amber-500/50 shadow-[0_0_12px_rgba(245,158,11,0.3)] text-center flex items-center space-x-2">
                                <div class="text-right">
                                    <span class="block text-[8px] font-mono-telemetry tracking-widest text-amber-400 uppercase font-black">Progress</span>
                                    <span id="pclPercentageValue" class="text-xs sm:text-sm font-black font-mono-telemetry text-amber-300">0%</span>
                                </div>
                                <div class="w-2.5 h-6 bg-amber-500/20 rounded-full overflow-hidden flex flex-col justify-end border border-amber-400/60">
                                    <div id="pclPercentageBar" class="w-full bg-amber-400 animate-pulse shadow-[0_0_8px_#fbbf24]" style="height: 0%;"></div>
                                </div>
                            </div>
                            <div class="bg-black/90 px-3.5 py-2 rounded-xl border border-cyan-500/50 shadow-[0_0_12px_rgba(6,182,212,0.3)] text-center">
                                <span class="block text-[8px] font-mono-telemetry tracking-widest text-cyan-400 uppercase font-black">+Didata</span>
                                <span id="pclProgHarianValue" class="text-base sm:text-lg font-black font-mono-telemetry text-cyan-300">0</span>
                            </div>
                            <div class="bg-black/90 px-3.5 py-1.5 rounded-xl border border-red-500/50 shadow-[0_0_15px_rgba(239,68,68,0.3)] text-right hidden sm:block">
                                <span class="block text-[8px] font-mono-telemetry tracking-widest text-red-400 uppercase font-black">Sisa Target</span>
                                <span id="pclSisaTargetValue" class="text-xl sm:text-2xl font-black font-mono-telemetry animate-blink text-red-500 drop-shadow-[0_0_10px_rgba(239,68,68,0.9)]">0</span>
                            </div>
                        </div>
                    </div>

                    <div class="sm:hidden bg-black/90 px-3.5 py-1.5 rounded-xl border border-red-500/50 shadow-[0_0_15px_rgba(239,68,68,0.3)] text-center">
                        <span class="block text-[8px] font-mono-telemetry tracking-widest text-red-400 uppercase font-black">Sisa Target</span>
                        <span id="pclSisaTargetValueMobile" class="text-xl font-black font-mono-telemetry animate-blink text-red-500 drop-shadow-[0_0_10px_rgba(239,68,68,0.9)]">0</span>
                    </div>

                    <div id="pclCockpitGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5"></div>
                </div>
            </div>

        </div>

    </main>

    <!-- Footer -->
    <footer class="mt-12 py-6 text-center text-xs sm:text-sm font-bold text-amber-300 tracking-wider border-t border-orange-500/20 bg-slate-950/40 shadow-inner">
        Website by vanndawir • mentas siji mentas kabeh
    </footer>

    <!-- JavaScript Interaktif -->
    <script>
        window.addEventListener('load', () => {
            setTimeout(() => {
                const splash = document.getElementById('welcomeSplash');
                if (splash) {
                    splash.style.opacity = '0';
                    setTimeout(() => {
                        splash.style.display = 'none';
                    }, 700);
                }
            }, 1200);
        });

        const targetDate = new Date('2026-08-17T10:00:00').getTime();
        function updateCountdown() {
            const now = new Date().getTime();
            const distance = targetDate - now;
            const timerEl = document.getElementById('countdownTimer');
            if (!timerEl) return;

            if (distance < 0) {
                timerEl.innerText = "Waktu Tiba!";
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            timerEl.innerText = `${days} Hari ${hours} Jam ${minutes} Menit`;
        }
        setInterval(updateCountdown, 1000);
        updateCountdown();

        const detailedPmlData = <%- JSON.stringify(typeof detailedPml !== 'undefined' && detailedPml ? detailedPml : []) %>;
        const detailedPclData = <%- JSON.stringify(typeof detailedPcl !== 'undefined' && detailedPcl ? detailedPcl : []) %>;

        function parseNum(val) {
            if (typeof val === 'number') {
                val = String(val);
            }
            if (!val) return 0;
            let str = String(val).trim();
            if (str.includes('.') && str.includes(',')) {
                str = str.replace(/\./g, '').replace(',', '.');
            } else if (str.indexOf('.') !== -1) {
                if (/\.\d{3}$/.test(str) || /^\d{1,3}\.\d{3}$/.test(str) || /^\d{1,3}\.\d{3}\.\d{3}$/.test(str)) {
                    str = str.replace(/\./g, '');
                }
            } else if (str.indexOf(',') !== -1) {
                if (/,\d{3}$/.test(str)) {
                    str = str.replace(/,/g, '');
                } else {
                    str = str.replace(',', '.');
                }
            }
            return parseFloat(str) || 0;
        }

        function getFilteredCells(rawCells) {
            if (!rawCells || !Array.isArray(rawCells)) return [];
            return rawCells.slice(-8);
        }

        function getPmlFilteredCells(rawCells) {
            if (!rawCells || !Array.isArray(rawCells)) return [];
            let cells = rawCells.slice(-8);
            return cells.filter(cell => {
                const h = (cell.header || '').toLowerCase();
                const isJumlahDidataDraft = (h.includes('jumlah') && h.includes('didata') && h.includes('draft')) || h.includes('didata + draft') || h.includes('didata+draft');
                return !isJumlahDidataDraft;
            });
        }

        const pmlSelect = document.getElementById('pmlSelect');
        const pmlTitle = document.getElementById('pmlSelectedNameTitle');
        const pmlSisa = document.getElementById('pmlSisaTargetValue');
        const pmlSisaMob = document.getElementById('pmlSisaTargetValueMobile');
        const pmlPctVal = document.getElementById('pmlPercentageValue');
        const pmlPctBar = document.getElementById('pmlPercentageBar');
        const pmlGrid = document.getElementById('pmlCockpitGrid');
        const pmlPlace = document.getElementById('pmlPlaceholder');
        const pmlCont = document.getElementById('pmlContentContainer');

        const pclSelect = document.getElementById('pclSelect');
        const pclTitle = document.getElementById('pclSelectedNameTitle');
        const pclPctVal = document.getElementById('pclPercentageValue');
        const pclPctBar = document.getElementById('pclPercentageBar');
        const pclProgHarianVal = document.getElementById('pclProgHarianValue');
        const pclSisa = document.getElementById('pclSisaTargetValue');
        const pclSisaMob = document.getElementById('pclSisaTargetValueMobile');
        const pclGrid = document.getElementById('pclCockpitGrid');
        const pclPlace = document.getElementById('pclPlaceholder');
        const pclCont = document.getElementById('pclContentContainer');

        if (pmlSelect) {
            pmlSelect.addEventListener('change', () => {
                const val = pmlSelect.value;
                if (val === "") {
                    pmlPlace.classList.remove('hidden');
                    pmlCont.classList.add('hidden');
                    return;
                }

                if (pclSelect) pclSelect.value = "";
                if (pclPlace) pclPlace.classList.add('hidden');
                if (pclCont) pclCont.classList.add('hidden');

                const item = detailedPmlData[parseInt(val, 10)];
                if (!item) return;

                pmlPlace.classList.add('hidden');
                pmlCont.classList.remove('hidden');

                let gridHtml = '';
                let didataVal = 0;
                let targetVal = 0;

                if (item.rawCells && Array.isArray(item.rawCells)) {
                    item.rawCells.forEach(cell => {
                        const hLower = (cell.header || '').toLowerCase();
                        const cValNum = parseNum(cell.value);

                        if ((hLower.includes('total usaha keluarga') || hLower.includes('usaha keluarga')) && !hLower.includes('target') && !hLower.includes('prelist')) {
                            if (cValNum > didataVal) didataVal = cValNum;
                        } else if (didataVal === 0 && (hLower.includes('didata') || hLower.includes('realisasi')) && !hLower.includes('target') && !hLower.includes('prelist')) {
                            didataVal = cValNum;
                        }

                        if ((hLower.includes('target') || hLower.includes('beban') || hLower.includes('sasaran')) && !hLower.includes('prelist') && !hLower.includes('pre-list')) {
                            targetVal = cValNum;
                        }
                    });

                    if (didataVal === 0) {
                        item.rawCells.forEach(cell => {
                            const hLower = (cell.header || '').toLowerCase();
                            const cValNum = parseNum(cell.value);
                            if (!hLower.includes('target') && !hLower.includes('prelist') && cValNum > didataVal) {
                                didataVal = cValNum;
                            }
                        });
                    }

                    if (targetVal === 0) {
                        item.rawCells.forEach(cell => {
                            const hLower = (cell.header || '').toLowerCase();
                            const cValNum = parseNum(cell.value);
                            if (hLower.includes('target') || hLower.includes('beban') || hLower.includes('sasaran')) {
                                targetVal = cValNum;
                            }
                        });
                    }

                    let cells = getPmlFilteredCells(item.rawCells);
                    cells.sort((a, b) => {
                        const ha = (a.header || '').toLowerCase();
                        const hb = (b.header || '').toLowerCase();
                        if (ha.includes('target') && !ha.includes('prelist')) return -1;
                        if (hb.includes('target') && !hb.includes('prelist')) return 1;
                        if (ha.includes('didata') || ha.includes('usaha')) return -1;
                        if (hb.includes('didata') || hb.includes('usaha')) return 1;
                        return ha.localeCompare(hb);
                    });

                    cells.forEach(cell => {
                        const header = cell.header || 'Label';
                        const cVal = cell.value || 0;
                        gridHtml += `
                            <div class="bg-black/90 p-3 rounded-xl border border-slate-800 flex justify-between items-center shadow">
                                <span class="text-[10px] font-bold text-slate-300 uppercase tracking-wider">${header}</span>
                                <span class="text-xs sm:text-sm font-black font-mono-telemetry text-white">${typeof cVal === 'number' ? cVal.toLocaleString('id-ID') : cVal}</span>
                            </div>
                        `;
                    });
                }

                pmlTitle.innerText = didataVal.toLocaleString('id-ID');
                const pmlPct = targetVal > 0 ? (didataVal / targetVal) * 100 : 0;
                pmlPctVal.innerText = pmlPct.toFixed(1) + '%';
                pmlPctBar.style.height = Math.min(Math.max(pmlPct, 0), 100) + '%';

                const pmlSisaTarget = Math.max(targetVal - didataVal, 0);
                pmlSisa.innerText = pmlSisaTarget.toLocaleString('id-ID');
                if (pmlSisaMob) pmlSisaMob.innerText = pmlSisaTarget.toLocaleString('id-ID');

                pmlGrid.innerHTML = gridHtml || '<div class="col-span-full text-center text-xs text-slate-500 italic">Tidak ada rincian data</div>';
            });
        }

        if (pclSelect) {
            pclSelect.addEventListener('change', () => {
                const val = pclSelect.value;
                if (val === "") {
                    pclPlace.classList.remove('hidden');
                    pclCont.classList.add('hidden');
                    return;
                }

                if (pmlSelect) pmlSelect.value = "";
                if (pmlPlace) pmlPlace.classList.add('hidden');
                if (pmlCont) pmlCont.classList.add('hidden');

                const item = detailedPclData[parseInt(val, 10)];
                if (!item) return;

                pclPlace.classList.add('hidden');
                pclCont.classList.remove('hidden');

                let gridHtml = '';
                let didataVal = 0;
                let targetVal = 0;
                let progHarianVal = 0;

                if (item.rawCells && Array.isArray(item.rawCells)) {
                    item.rawCells.forEach(cell => {
                        const hLower = (cell.header || '').toLowerCase();
                        const cValNum = parseNum(cell.value);

                        if (hLower.includes('+didata') || hLower.includes('+ didata')) {
                            progHarianVal = cValNum;
                        } else if ((hLower.includes('total usaha keluarga') || hLower.includes('usaha keluarga')) && !hLower.includes('target') && !hLower.includes('prelist')) {
                            if (cValNum > didataVal) didataVal = cValNum;
                        } else if (didataVal === 0 && (hLower.includes('didata') || hLower.includes('realisasi')) && !hLower.includes('target') && !hLower.includes('prelist') && !hLower.includes('draft')) {
                            didataVal = cValNum;
                        }

                        if ((hLower.includes('target') || hLower.includes('beban') || hLower.includes('sasaran')) && !hLower.includes('prelist') && !hLower.includes('pre-list')) {
                            targetVal = cValNum;
                        }
                    });

                    if (didataVal === 0) {
                        item.rawCells.forEach(cell => {
                            const hLower = (cell.header || '').toLowerCase();
                            const cValNum = parseNum(cell.value);
                            if (!hLower.includes('target') && !hLower.includes('prelist') && !hLower.includes('draft') && !hLower.includes('+didata') && cValNum > didataVal) {
                                didataVal = cValNum;
                            }
                        });
                    }

                    if (targetVal === 0) {
                        item.rawCells.forEach(cell => {
                            const hLower = (cell.header || '').toLowerCase();
                            const cValNum = parseNum(cell.value);
                            if (hLower.includes('target') || hLower.includes('beban') || hLower.includes('sasaran')) {
                                targetVal = cValNum;
                            }
                        });
                    }

                    let cells = getPmlFilteredCells(item.rawCells);
                    cells.sort((a, b) => {
                        const ha = (a.header || '').toLowerCase();
                        const hb = (b.header || '').toLowerCase();
                        if (ha.includes('target') && !ha.includes('prelist')) return -1;
                        if (hb.includes('target') && !hb.includes('prelist')) return 1;
                        if (ha.includes('didata') || ha.includes('usaha')) return -1;
                        if (hb.includes('didata') || hb.includes('usaha')) return 1;
                        return ha.localeCompare(hb);
                    });

                    cells.forEach(cell => {
                        const header = cell.header || 'Label';
                        const cVal = cell.value || 0;
                        gridHtml += `
                          <div class="bg-black/90 p-3 rounded-xl border border-slate-800 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-1.5 shadow"> 
                                <span class="text-[10px] font-bold text-slate-300 uppercase tracking-wider">${header}</span>
                                <span class="text-xs sm:text-sm font-black font-mono-telemetry text-white">${typeof cVal === 'number' ? cVal.toLocaleString('id-ID') : cVal}</span>
                            </div>
                        `;
                    });
                }

                pclTitle.innerText = didataVal.toLocaleString('id-ID');
                const pclPct = targetVal > 0 ? (didataVal / targetVal) * 100 : 0;
                pclPctVal.innerText = pclPct.toFixed(1) + '%';
                pclPctBar.style.height = Math.min(Math.max(pclPct, 0), 100) + '%';

                if (pclProgHarianVal) pclProgHarianVal.innerText = progHarianVal.toLocaleString('id-ID');

                const pclSisaTarget = Math.max(targetVal - didataVal, 0);
                pclSisa.innerText = pclSisaTarget.toLocaleString('id-ID');
                if (pclSisaMob) pclSisaMob.innerText = pclSisaTarget.toLocaleString('id-ID');

                pclGrid.innerHTML = gridHtml || '<div class="col-span-full text-center text-xs text-slate-500 italic">Tidak ada rincian data</div>';
            });
        }
    </script>
</body>
</html>