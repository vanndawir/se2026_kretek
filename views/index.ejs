<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitoring Lapangan SE2026 - Kapanewon Kretek</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #090d16 0%, #171f2f 50%, #1a1006 100%);
            min-height: 100vh;
        }

        .font-mono-telemetry {
            font-family: 'JetBrains Mono', monospace;
        }

        .glass-card {
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.85) 0%, rgba(20, 27, 43, 0.9) 100%);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(249, 115, 22, 0.25);
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        }

        .target-static {
            color: #fbbf24 !important;
            text-shadow: 0 0 12px rgba(251, 191, 36, 0.9);
            font-weight: 900;
        }

        .pcl-progress-default {
            color: #fbbf24 !important;
            text-shadow: 0 0 12px rgba(251, 191, 36, 0.9);
        }

        .pcl-progress-blink {
            color: #f59e0b !important;
            text-shadow: 0 0 14px rgba(245, 158, 11, 0.9);
            animation: progressBlink 0.8s infinite alternate;
        }

        @keyframes progressBlink {
            0% { opacity: 1; transform: scale(1); }
            100% { opacity: 0.35; transform: scale(1.05); }
        }

        .pcl-progress-bar {
            background: linear-gradient(180deg, #fbbf24 0%, #f59e0b 100%) !important;
            box-shadow: 0 0 16px rgba(251, 191, 36, 0.9);
        }

        .plus-data-ok {
            color: #22c55e !important;
            text-shadow: 0 0 12px rgba(34, 197, 94, 0.9);
            animation: plusOkBlink 0.5s infinite alternate;
        }

        .plus-data-low {
            color: #ef4444 !important;
            text-shadow: 0 0 14px rgba(239, 68, 68, 0.9);
            animation: plusLowBlink 0.45s infinite alternate;
        }

        @keyframes plusOkBlink {
            0% { opacity: 1; transform: scale(1); }
            100% { opacity: 0.65; transform: scale(1.04); }
        }

        @keyframes plusLowBlink {
            0% { opacity: 1; transform: scale(1); }
            100% { opacity: 0.55; transform: scale(1.08); }
        }

        #pclAlarmPanel {
            display: none;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 0.7rem 0.9rem;
            border-radius: 0.9rem;
            border: 2px solid rgba(239, 68, 68, 0.9);
            background: linear-gradient(135deg, rgba(127, 29, 29, 0.9), rgba(69, 10, 10, 0.95));
            box-shadow: 0 0 22px rgba(239, 68, 68, 0.9);
        }

        #pclAlarmPanel.active {
            display: flex;
        }

        #stopPclAlarmBtn {
            border: 1px solid rgba(255, 255, 255, 0.8);
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            color: #111827;
            border-radius: 0.75rem;
            padding: 0.5rem 0.8rem;
            font-weight: 900;
            letter-spacing: 0.04em;
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        #stopPclAlarmBtn:hover {
            transform: translateY(-1px);
            box-shadow: 0 0 18px rgba(255,255,255,0.7);
        }

        #pclLowWarningBar {
            overflow: hidden;
            white-space: nowrap;
            border-radius: 0.75rem;
            border: 1px solid rgba(239, 68, 68, 0.7);
            background: linear-gradient(135deg, rgba(127, 29, 29, 0.8), rgba(69, 10, 10, 0.95));
            box-shadow: 0 0 16px rgba(239, 68, 68, 0.8);
        }

        #pclHeroicBanner {
            display: none;
            text-align: center;
            padding: 0.8rem 1rem;
            border-radius: 0.9rem;
            border: 2px solid rgba(34, 197, 94, 0.9);
            background: linear-gradient(135deg, rgba(20, 83, 45, 0.95), rgba(6, 78, 59, 0.95));
            box-shadow: 0 0 25px rgba(34, 197, 94, 0.8);
            color: #f0fdf4;
            font-weight: 800;
            letter-spacing: 0.03em;
        }

        #pclHeroicBanner.active {
            display: block;
            animation: heroicPulse 1.5s infinite alternate;
        }

        @keyframes heroicPulse {
            0% { box-shadow: 0 0 15px rgba(34, 197, 94, 0.6); }
            100% { box-shadow: 0 0 30px rgba(34, 197, 94, 1); }
        }

        .pcl-warning-text {
            display: inline-block;
            padding: 0.45rem 1rem;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #fecaca;
            animation: warningScroll 7s linear infinite;
        }

        @keyframes warningScroll {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }
    </style>
</head>
<body class="text-slate-100 min-h-screen antialiased selection:bg-orange-500 selection:text-white overflow-x-hidden">
    <div id="welcomeSplash" class="fixed inset-0 z-[100] bg-gradient-to-b from-orange-600 via-orange-950 to-black flex flex-col items-center justify-center transition-opacity duration-700">
        <img src="/images/logo_kretek.png" alt="Logo Kapanewon Kretek" class="h-44 sm:h-60 w-auto object-contain animate-pulse drop-shadow-2xl" onerror="this.style.display='none'">
    </div>

    <header class="glass-card sticky top-0 z-50 border-b border-orange-500/30 shadow-2xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-24 flex items-center justify-between">
            <div class="flex items-center space-x-3.5 flex-shrink-0">
                <img src="/images/logo_bps.png" alt="Logo BPS" class="h-12 sm:h-14 w-auto object-contain drop-shadow" onerror="this.style.display='none'">
                <div class="hidden sm:block border-l border-slate-700/80 pl-3.5">
                    <span class="block text-xs uppercase tracking-widest text-orange-400 font-bold">Kapanewon</span>
                    <span class="text-base sm:text-lg font-extrabold tracking-tight bg-gradient-to-r from-orange-400 to-amber-200 bg-clip-text text-transparent">Kretek</span>
                </div>
            </div>

            <div class="flex-1 text-center px-2">
                <h1 class="text-xs sm:text-base font-extrabold tracking-tight text-white uppercase drop-shadow">Monitoring Lapangan SE2026</h1>
                <div class="mt-1">
                    <span class="inline-block text-xs font-extrabold text-amber-300 tracking-wider bg-orange-950/40 px-3 py-0.5 rounded-full border border-orange-500/30">
                        📅 Update Data Tanggal: <%= typeof activeDate !== 'undefined' ? activeDate : '-' %>
                    </span>
                </div>
            </div>

            <div class="flex items-center flex-shrink-0 bg-white px-2.5 py-1.5 rounded-xl shadow-lg border border-slate-300">
                <img src="/images/logo_se.png" alt="Logo SE" class="h-9 sm:h-11 w-auto object-contain" onerror="this.style.display='none'">
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-5 sm:py-8 space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
            <div class="rounded-2xl shadow-2xl overflow-hidden border-2 border-red-500/80 flex flex-col sm:flex-row items-center justify-between relative bg-gradient-to-r from-slate-950 via-red-950/40 to-slate-950">
                <div class="absolute inset-0 opacity-15 pointer-events-none" style="background-image: radial-gradient(#ef4444 1px, transparent 1px); background-size: 16px 16px;"></div>

                <div class="relative z-10 p-5 sm:p-6 flex flex-col justify-center w-full sm:w-auto">
                    <div class="flex items-center space-x-2 mb-1.5">
                        <span class="inline-block w-2.5 h-2.5 rounded-full bg-red-500 animate-ping shadow-md"></span>
                        <span class="text-[10px] font-black text-red-400 tracking-wider uppercase font-mono bg-black/60 px-2.5 py-0.5 rounded border border-red-500/30 shadow">MotoGP Circuit</span>
                    </div>
                    <h2 class="text-sm sm:text-base font-black text-white tracking-wide uppercase bg-red-600/90 px-3 py-1.5 rounded-xl border border-red-400 shadow-md inline-block w-fit">🏁 Race to 31 Agustus 2026</h2>
                </div>

                <div class="relative z-10 p-5 sm:p-6 flex items-center justify-end w-full sm:w-auto">
                    <div class="bg-black/95 px-4 sm:px-5 py-2.5 sm:py-3 rounded-xl border-2 border-red-500 shadow-[0_0_25px_rgba(220,38,38,0.5)] text-center relative">
                        <div class="absolute -top-2.5 left-1/2 transform -translate-x-1/2 bg-red-600 text-white text-[8px] font-black px-2 py-0.5 rounded uppercase tracking-widest shadow whitespace-nowrap">MotoGP Countdown</div>
                        <div id="countdownTimer" class="text-base sm:text-lg font-black text-white tracking-wider font-mono drop-shadow-[0_0_8px_rgba(255,255,255,0.8)]">00 Hari 00 Jam</div>
                        <span class="text-[9px] text-slate-200 uppercase tracking-widest font-extrabold">Final Lap Finish</span>
                    </div>
                </div>
            </div>

            <div class="glass-card rounded-2xl p-5 sm:p-6 shadow-2xl border-l-4 border-l-orange-500 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-gradient-to-r from-slate-900/90 via-slate-900/80 to-orange-950/30">
                <div class="flex flex-col">
                    <h2 class="text-sm sm:text-lg font-extrabold text-white tracking-wide uppercase">Capaian Pendataan Lapangan</h2>
                    <div class="mt-2 text-xl sm:text-2xl font-black text-orange-300 tracking-wide font-mono-telemetry drop-shadow-[0_0_10px_rgba(251,146,60,0.8)]">
                        3402030
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
                    <div class="w-full sm:w-auto bg-black/90 px-4 sm:px-5 py-2.5 sm:py-3 rounded-2xl border-2 border-orange-500/60 shadow-[0_0_20px_rgba(249,115,22,0.4)] flex items-center justify-between sm:justify-center space-x-3">
                        <div class="text-right">
                            <span class="block text-[9px] text-orange-400 uppercase tracking-widest font-black">Live Gauge</span>
                            <span class="text-2xl sm:text-3xl font-black text-orange-400 tracking-tighter drop-shadow-[0_0_8px_rgba(249,115,22,0.8)]"><%= typeof persentaseKretek !== 'undefined' ? persentaseKretek : '0.00' %>%</span>
                        </div>
                        <div class="w-3 h-8 bg-orange-500/20 rounded-full overflow-hidden flex flex-col justify-end border border-orange-400/80">
                            <div class="w-full bg-orange-500 animate-pulse shadow-[0_0_10px_#f97316]" style="height: <%= Math.min(Math.max(parseFloat(typeof persentaseKretek !== 'undefined' ? persentaseKretek : 0), 0), 100) %>%;"></div>
                        </div>
                    </div>

                    <div class="w-full sm:w-auto bg-black/90 px-4 sm:px-5 py-2.5 sm:py-3 rounded-2xl border-2 border-sky-500/60 shadow-[0_0_20px_rgba(56,189,248,0.4)] flex items-center justify-between sm:justify-center space-x-3">
                        <div class="text-right">
                            <span class="block text-[9px] text-sky-400 uppercase tracking-widest font-black">% Rsp. Draft</span>
                            <span class="text-2xl sm:text-3xl font-black text-sky-400 tracking-tighter drop-shadow-[0_0_8px_rgba(56,189,248,0.8)]"><%= typeof persentaseDraftKretek !== 'undefined' ? persentaseDraftKretek : '0.00%' %></span>
                        </div>
                        <div class="w-3 h-8 bg-sky-500/20 rounded-full overflow-hidden flex flex-col justify-end border border-sky-400/80">
                            <div class="w-full bg-sky-500 animate-pulse shadow-[0_0_10px_#38bdf8]" style="height: <%= Math.min(Math.max(parseFloat(typeof persentaseDraftKretek !== 'undefined' ? persentaseDraftKretek.replace('%','') : 0), 0), 100) %>%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="glass-card rounded-2xl p-4 sm:p-5 shadow-xl border border-orange-500/30 flex flex-col sm:flex-row items-center justify-between gap-4 bg-gradient-to-r from-slate-900/90 via-orange-950/20 to-slate-900/90">
            <div class="text-center sm:text-left">
                <span class="text-[10px] font-bold uppercase tracking-wider text-orange-400">Ruang Motivasi & Relaksasi Petugas</span>
                <h2 class="text-sm sm:text-base font-extrabold text-white mt-0.5">Butuh Dorongan Semangat atau Lagi Lelah / Galau?</h2>
            </div>
            <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3">
                <a href="https://www.tiktok.com/@parangrockers/video/7645650383875886356?is_from_webapp=1&sender_device=pc&web_id=7668942723827959313" target="_blank" class="flex-1 sm:flex-none text-center bg-gradient-to-r from-orange-600 to-amber-600 hover:from-orange-500 hover:to-amber-500 text-white text-xs font-bold px-3.5 py-2.5 rounded-xl shadow-lg border border-orange-400/50 flex items-center justify-center space-x-2 transition transform hover:scale-105">
                    <span>🔥 Saat Butuh Semangat</span>
                    <span class="text-amber-200 animate-pulse">👉</span>
                </a>
                <a href="https://www.tiktok.com/@parangrockers/video/7654901051283229972?is_from_webapp=1&sender_device=pc&web_id=7668942723827959313" target="_blank" class="flex-1 sm:flex-none text-center bg-gradient-to-r from-slate-800 to-slate-900 hover:from-slate-700 hover:to-slate-800 text-amber-300 text-xs font-bold px-3.5 py-2.5 rounded-xl shadow-lg border border-slate-700 flex items-center justify-center space-x-2 transition transform hover:scale-105">
                    <span>☕ Saat Galau & Lelah</span>
                    <span class="text-amber-400 animate-pulse">👉</span>
                </a>
            </div>
        </div>

        <div class="glass-card rounded-2xl p-4 sm:p-6 shadow-xl border-t-4 border-t-amber-500 flex flex-col space-y-4">
            <div class="flex justify-between items-center">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-amber-400">Rekapitulasi Wilayah Desa</p>
                    <h2 class="text-base font-extrabold text-white mt-0.5">Progress per Desa / Kalurahan</h2>
                </div>
                <span class="bg-amber-500/20 text-amber-300 text-xs font-bold px-3 py-1 rounded-full border border-amber-500/30">
                    Total Desa: <%= (typeof parsedDesa !== 'undefined' && parsedDesa) ? parsedDesa.length : 0 %>
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                <% if (typeof parsedDesa === 'undefined' || !parsedDesa || parsedDesa.length === 0) { %>
                    <div class="col-span-full py-8 text-center text-slate-400 italic bg-slate-950/40 rounded-xl border border-slate-800">Tidak ada data desa tersedia</div>
                <% } else { %>
                    <% parsedDesa.forEach(desa => { %>
                        <% const pct = typeof desa.capaian !== 'undefined' ? desa.capaian : (desa.target > 0 ? ((desa.didata / desa.target) * 100) : 0); %>
                        <div class="p-4 rounded-xl border border-slate-700 bg-gradient-to-br from-gray-900 via-black to-gray-900 shadow-[inset_0_0_20px_rgba(255,255,255,0.05),_0_10px_20px_rgba(0,0,0,0.5)] relative overflow-hidden">
                            <div class="absolute inset-0 opacity-20" style="background-image: repeating-linear-gradient(45deg, #000 25%, transparent 25%, transparent 75%, #000 75%, #000), repeating-linear-gradient(45deg, #000 25%, #1a1a1a 25%, #1a1a1a 75%, #000 75%, #000); background-position: 0 0, 4px 4px; background-size: 8px 8px;"></div>
                            <div class="relative z-10 flex flex-col space-y-3">
                                <div class="flex justify-between items-center border-b border-slate-800 pb-2">
                                    <span class="text-xs font-black uppercase text-orange-400 tracking-wider"><%= desa.name %></span>
                                    <div class="flex items-center space-x-1">
                                        <div class="w-2.5 h-1.5 bg-green-500 skew-x-[15deg] shadow-[0_0_4px_#22c55e]"></div>
                                        <div class="w-2.5 h-1.5 bg-green-500 skew-x-[15deg] shadow-[0_0_4px_#22c55e]"></div>
                                        <div class="w-2.5 h-1.5 bg-yellow-400 skew-x-[15deg] shadow-[0_0_4px_#facc15]"></div>
                                        <div class="w-2.5 h-1.5 bg-red-600 skew-x-[15deg] animate-pulse shadow-[0_0_6px_#dc2626]"></div>
                                    </div>
                                </div>
                                <div class="flex justify-between items-end gap-2">
                                    <div class="flex-1">
                                        <span class="block text-[9px] sm:text-[10px] leading-tight font-bold font-mono-telemetry text-slate-300 uppercase tracking-tight break-words">USAHA BKU & KELUARGA DITEMUKAN/BARU/FORCE SUBMIT</span>
                                        <div class="mt-1">
                                            <span class="text-2xl sm:text-3xl font-black text-white italic font-mono-telemetry tracking-tighter block"><%= (desa.didata || 0).toLocaleString('id-ID') %></span>
                                        </div>
                                        <div class="flex flex-col mt-2">
                                            <span class="text-[8px] font-mono-telemetry text-amber-400 font-bold uppercase tracking-wider">Target</span>
                                            <span class="text-base sm:text-lg font-extrabold text-slate-300 font-mono-telemetry"><%= (desa.target || 0).toLocaleString('id-ID') %></span>
                                        </div>
                                    </div>
                                    <div class="flex flex-col items-end gap-2 flex-shrink-0">
                                        <div class="bg-black/90 px-3 py-1.5 rounded-xl border border-amber-500/50 shadow-[0_0_12px_rgba(245,158,11,0.3)] text-center flex items-center space-x-2">
                                            <div class="text-right">
                                                <span class="block text-[8px] font-mono-telemetry tracking-widest text-amber-400 uppercase font-black">Capaian</span>
                                                <span class="text-xs font-black font-mono-telemetry text-amber-300"><%= pct.toFixed(2) %>%</span>
                                            </div>
                                            <div class="w-2.5 h-5 bg-amber-500/20 rounded-full overflow-hidden flex flex-col justify-end border border-amber-400/60">
                                                <div class="w-full bg-amber-400 animate-pulse shadow-[0_0_6px_#fbbf24]" style="height: <%= Math.min(Math.max(pct, 0), 100) %>%;"></div>
                                            </div>
                                        </div>
                                        <div class="bg-black/90 px-3.5 py-1.5 rounded-xl border border-sky-500/50 text-right shadow-[0_0_10px_rgba(56,189,248,0.2)]">
                                            <span class="text-xs font-mono-telemetry text-sky-400 uppercase font-black">% Resp. Draft: </span>
                                            <span class="text-xs sm:text-sm font-black font-mono-telemetry text-sky-300"><%= desa.draftStr || '0.00%' %></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 sm:gap-6">
            <div class="glass-card rounded-2xl p-4 sm:p-6 shadow-xl border-t-4 border-t-amber-500 flex flex-col space-y-4 w-full min-w-0">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-amber-400">Petugas PML</p>
                    <h2 class="text-base font-extrabold text-white mt-0.5">Pilih Nama untuk Rincian</h2>
                </div>

                <div>
                    <select id="pmlSelect" class="w-full bg-slate-900/90 border border-slate-700 text-white text-sm font-semibold rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer shadow-inner">
                        <option value="" selected>-- Cari Nama PML --</option>
                        <% if (typeof detailedPml !== 'undefined' && detailedPml) { %>
                            <% detailedPml.forEach((p, idx) => { %>
                                <% const pmlName = (p.name || '').trim().toLowerCase(); %>
                                <% if (pmlName && !pmlName.includes('target') && !pmlName.includes('prelit') && !pmlName.includes('prelist')) { %>
                                    <option value="<%= idx %>"><%= p.name %></option>
                                <% } %>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div id="pmlPlaceholder" class="py-8 text-center text-xs text-slate-400 italic bg-slate-950/40 rounded-xl border border-slate-800/80">
                    Silakan pilih nama PML untuk menampilkan rincian data
                </div>

                <div id="pmlContentContainer" class="space-y-3.5 hidden">
                    <div class="p-3 sm:p-5 rounded-xl border border-slate-700 bg-gradient-to-br from-gray-900 via-black to-gray-900 shadow-[inset_0_0_20px_rgba(255,255,255,0.05),_0_10px_20px_rgba(0,0,0,0.5)] flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 relative overflow-hidden">
                        <div class="absolute inset-0 opacity-20" style="background-image: repeating-linear-gradient(45deg, #000 25%, transparent 25%, transparent 75%, #000 75%, #000), repeating-linear-gradient(45deg, #000 25%, #1a1a1a 25%, #1a1a1a 75%, #000 75%, #000); background-position: 0 0, 4px 4px; background-size: 8px 8px;"></div>

                        <div class="relative z-10 flex flex-col justify-start">
                            <div class="flex items-center space-x-1 sm:space-x-1.5 mb-1 sm:mb-2 flex-wrap gap-y-1">
                                <div class="flex items-center space-x-1">
                                    <div class="w-3 sm:w-4 h-1.5 bg-green-500 skew-x-[15deg] shadow-[0_0_6px_#22c55e]"></div>
                                    <div class="w-3 sm:w-4 h-1.5 bg-green-500 skew-x-[15deg] shadow-[0_0_6px_#22c55e]"></div>
                                    <div class="w-3 sm:w-4 h-1.5 bg-green-500 skew-x-[15deg] shadow-[0_0_6px_#22c55e]"></div>
                                    <div class="w-3 sm:w-4 h-1.5 bg-yellow-400 skew-x-[15deg] shadow-[0_0_6px_#facc15]"></div>
                                    <div class="w-3 sm:w-4 h-1.5 bg-yellow-400 skew-x-[15deg] shadow-[0_0_6px_#facc15]"></div>
                                    <div class="w-3 sm:w-4 h-1.5 bg-red-600 skew-x-[15deg] animate-pulse shadow-[0_0_10px_#dc2626]"></div>
                                </div>
                                <span class="ml-1 text-[8px] sm:text-[9px] leading-tight font-mono-telemetry font-black text-slate-300 tracking-tight uppercase">USAHA BKU & KELUARGA DITEMUKAN/BARU/FORCE SUBMIT</span>
                            </div>

                            <div class="flex items-end gap-3 mt-1">
                                <div class="text-left">
                                    <span id="pmlSelectedValue" class="block text-4xl sm:text-6xl font-black text-white italic tracking-tighter drop-shadow-[0_0_15px_rgba(255,255,255,0.4)] font-mono-telemetry leading-none">0</span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center space-x-2 relative z-10">
