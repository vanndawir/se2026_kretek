<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitoring Lapangan SE2026 - Kapanewon Kretek</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-amber-900 via-orange-950 to-neutral-900 min-h-screen text-white font-sans p-4 md:p-8">
    <div class="max-w-6xl mx-auto space-y-6">
        
        <!-- Header Banner -->
        <div class="bg-black/40 backdrop-blur-md rounded-xl p-6 shadow-xl border border-orange-500/30 text-center">
            <h1 class="text-2xl md:text-3xl font-bold tracking-wide text-orange-400">MONITORING LAPANGAN</h1>
            <h2 class="text-lg md:text-xl font-semibold text-gray-200 mt-1">SE2026</h2>
            <p class="text-sm text-gray-400">Kapanewon Kretek</p>
            <div class="inline-block mt-3 px-4 py-1 bg-orange-600/30 border border-orange-500/50 rounded-full text-xs text-orange-300 font-medium">
                Data Tanggal: <%= activeDate %>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- Top 5 PCL Section -->
            <div class="bg-black/40 backdrop-blur-md rounded-xl p-6 shadow-xl border border-orange-500/30">
                <h3 class="text-lg font-semibold text-orange-400 mb-4 flex items-center gap-2">
                    🔥 Top 5 PCL (Progress Harian)
                </h3>
                <div class="space-y-3">
                    <% if (topPcl && topPcl.length > 0) { %>
                        <% topPcl.forEach((item, index) => { %>
                            <div class="flex justify-between items-center bg-orange-950/40 p-3 rounded-lg border border-orange-500/20">
                                <span class="text-sm font-medium"><%= index + 1 %>. <%= item.nama %></span>
                                <span class="px-2.5 py-1 bg-emerald-600/30 text-emerald-400 text-xs font-semibold rounded-md border border-emerald-500/30">+<%= item.harian %> Responden</span>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-sm text-gray-400 text-center py-4">Belum ada data PCL</p>
                    <% } %>
                </div>
            </div>

            <!-- Dropdown Wilayah & Petugas Section -->
            <div class="bg-black/40 backdrop-blur-md rounded-xl p-6 shadow-xl border border-orange-500/30 space-y-4">
                <h3 class="text-lg font-semibold text-orange-400 mb-2">Pencarian & Filter Wilayah</h3>
                
                <!-- Wilayah Kecamatan -->
                <div>
                    <label class="block text-xs font-semibold text-gray-300 mb-1">Wilayah Kecamatan</label>
                    <select class="w-full bg-neutral-900 border border-orange-500/40 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-orange-400">
                        <option value="">-- Pilih Kecamatan --</option>
                        <% if (kecamatan && kecamatan.length > 0) { %>
                            <% kecamatan.forEach(item => { %>
                                <option value="<%= item.nama %>"><%= item.nama %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <!-- Wilayah Desa -->
                <div>
                    <label class="block text-xs font-semibold text-gray-300 mb-1">Wilayah Desa</label>
                    <select class="w-full bg-neutral-900 border border-orange-500/40 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-orange-400">
                        <option value="">-- Pilih Desa --</option>
                        <% if (desa && desa.length > 0) { %>
                            <% desa.forEach(item => { %>
                                <option value="<%= item.nama %>"><%= item.nama %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <!-- Petugas PML -->
                <div>
                    <label class="block text-xs font-semibold text-gray-300 mb-1">Petugas PML</label>
                    <select class="w-full bg-neutral-900 border border-orange-500/40 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-orange-400">
                        <option value="">-- Pilih PML --</option>
                        <% if (pml && pml.length > 0) { %>
                            <% pml.forEach(item => { %>
                                <option value="<%= item.nama %>"><%= item.nama %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <!-- Petugas PCL -->
                <div>
                    <label class="block text-xs font-semibold text-gray-300 mb-1">Petugas PCL</label>
                    <select class="w-full bg-neutral-900 border border-orange-500/40 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-orange-400">
                        <option value="">-- Pilih PCL --</option>
                        <% if (pcl && pcl.length > 0) { %>
                            <% pcl.forEach(item => { %>
                                <option value="<%= item.nama %>"><%= item.nama %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
            </div>

        </div>
    </div>
</body>
</html>
